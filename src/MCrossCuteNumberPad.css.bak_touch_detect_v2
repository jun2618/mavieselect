orm:rotate(-24deg)}.dog>i:nth-child(2){right:5px;border-radius:20% 80%;transform:rotate(24deg)}.dog>div{position:absolute;z-index:2;top:62px;left:23px;width:142px;height:132px;border:4px solid #644843;border-radius:50%;background:radial-gradient(circle,#fffdf4,#eadbc2)}.dog>div>b{position:absolute;top:44px;width:25px;height:29px;border:4px solid #503a37;border-radius:50%;background:radial-gradient(circle at 35% 25%,#fff 0 12%,#452a29 18%)}.dog>div>b:first-child{left:27px}.dog>div>b:nth-child(2){right:24px}.dog em{position:absolute;left:59px;top:75px;width:25px;height:17px;border-radius:50%;background:#7e4d4b}.dog u{position:absolute;left:43px;top:88px;width:29px;height:42px;border:3px solid #75434a;border-radius:60%;background:#df8295;transform:rotate(28deg)}.dog>strong{position:absolute;top:176px;left:43px;width:100px;height:112px;padding-top:48px;border:4px solid #644843;border-radius:44% 44% 28% 28%;background:#d78596;color:#fff;text-align:center;font-size:12px}.dog>span{position:absolute;z-index:4;right:3px;top:174px;width:62px;height:68px;border:4px solid #644843;border-radius:50%;background:#fff4df;color:#865852;text-align:center;font-size:28px}.dog>span small{display:block;font-size:11px}.cutePad footer{margin-top:9px;color:#ad6774;font-size:10px;font-weight:800}@media(max-width:420px){.cutePad main{width:68%;gap:4px}.cutePad main button{min-height:50px}.dog{right:-30px;transform:scale(.88);transform-origin:bottom right}}@media(pointer:fine) and (min-width:1025px){.cuteBg{display:none!important}}