.costPage{--navy:#24243f;--pink:#e95d96;--green:#13815a;min-height:100vh;padding:16px;background:linear-gradient(#fffaf8,#fff);color:var(--navy);font-family:"Zen Maru Gothic","Yu Gothic",Meiryo,sans-serif}.costHero{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin-bottom:12px}.costBrand{display:flex;align-items:center;gap:8px;color:#d95291}.costBrand img{width:54px;height:54px;border-radius:14px}.costBrand div{display:grid}.costBrand small{font-size:15px}.costBrand strong{font-size:24px}.costHero h1{margin:0;font-size:34px;letter-spacing:.08em}.costHeroActions{display:flex;justify-content:flex-end;gap:8px}.costHeroActions button,.costSection button{min-height:42px;padding:8px 13px;border:1px solid #a7b5cb;border-radius:11px;background:#fff;color:var(--navy);font:inherit;font-weight:900}.costInfoCard{display:grid;grid-template-columns:110px 1fr 110px 1fr;gap:6px 12px;padding:14px;border:1px solid #ecdde0;border-radius:14px;background:#fff;box-shadow:0 5px 18px rgba(50,40,70,.06)}.costInfoCard label{display:contents}.costInfoCard label span{padding:7px 9px;border-radius:7px;background:#eef1f5;font-weight:900}.costInfoCard input{min-width:0;border:0;border-bottom:1px solid #d8dde5;background:transparent;font:inherit}.costKpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:12px 0}.costKpis article{min-height:116px;display:grid;place-items:center;padding:10px;border:1px solid;border-radius:12px}.costKpis article span{font-weight:900}.costKpis article strong,.costKpis article input{width:100%;border:0;background:transparent;text-align:center;font-size:30px;font-weight:900;color:inherit}.costKpis .estimate{background:#fde8ef;border-color:#f4c3d4;color:#bd2c5a}.costKpis .cost{background:#e2f5ee;border-color:#bde3d3;color:#13815a}.costKpis .profit{background:#e4f0ff;border-color:#bfd8f7;color:#1460c5}.costKpis .margin{background:#fff0e3;border-color:#f0ceb1;color:#994617}.costSection{margin:12px 0;border:1px solid #c7ced9;border-radius:13px;background:#fff;overflow:hidden}.costSection>header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:9px 12px}.costSection>header>div:first-child{display:flex;align-items:center;gap:8px}.costSection>header b{font-size:22px}.costSection>header strong{font-size:18px}.costSection>header small{font-weight:800}.costSection.blue>header{background:#e4f0ff;color:#1460c5}.costSection.pink>header{background:#fde8ef;color:#bd2c5a}.costSection.green>header{background:#e2f5ee;color:#13815a}.costSection.purple>header{background:#f0e5ff;color:#6031a5}.costSection.gray>header{background:#eef1f5;color:#46536a}.sectionTotal{display:flex;align-items:center;gap:12px}.sectionTotal>strong{font-size:22px}.costTable{overflow:auto}.costHead,.costRow{display:grid;grid-template-columns:52px minmax(180px,1.3fr) minmax(150px,1fr) 80px 68px 105px 115px minmax(150px,1fr) 56px;min-width:1000px}.costHead{background:#eef1f5;font-weight:900}.costHead span,.costRow>*{padding:8px;border-right:1px solid #c7ced9;border-top:1px solid #c7ced9}.costHead span{text-align:center}.costRow input{min-width:0;border:0;background:transparent;font:inherit}.costRow>span,.costRow>strong{text-align:right}.costRow>button{border:0;background:transparent}.costEmpty{padding:22px;text-align:center;color:#687083}.taxIncluded{grid-column:7/9;display:flex!important;gap:8px!important;align-items:center}.taxIncluded input{border-bottom:1px solid #ccc}.costBottom{display:grid;grid-template-columns:1.2fr .85fr .7fr;gap:12px;margin-top:14px}.costBottom>section{padding:12px;border:1px solid #d7dde6;border-radius:13px;background:#fff}.costBottom h3{margin:0 0 10px;font-size:17px}.costBottom textarea{width:100%;min-height:180px;box-sizing:border-box;border:1px solid #d8dde5;border-radius:10px;padding:10px;font:inherit}.costBottom section>div{display:flex;justify-content:space-between;padding:7px;border-bottom:1px solid #d8dde5}.costBottom .grand{font-size:20px;font-weight:900;background:#eef1f5}.profitLine{background:#fde8ef;color:#bd2c5a;font-size:18px;font-weight:900}.marginLine{background:#e4f0ff;color:#1460c5;font-size:18px;font-weight:900}@media(max-width:820px){.costPage{padding:8px}.costHero{grid-template-columns:1fr auto}.costHero h1{grid-column:1/-1;grid-row:1;text-align:center;font-size:27px}.costBrand{grid-row:2}.costHeroActions{grid-row:2}.costInfoCard{grid-template-columns:92px 1fr}.costKpis{grid-template-columns:1fr 1fr}.costSection>header{align-items:stretch;flex-direction:column}.sectionTotal{display:grid;grid-template-columns:auto 1fr}.sectionTotal button{grid-column:1/-1}.costBottom{grid-template-columns:1fr}.costBrand small{font-size:11px}.costBrand strong{font-size:18px}}@media print{.costHeroActions,.costSection button,.costRow>button{display:none!important}.costPage{padding:0;background:#fff}.costSection{break-inside:avoid}.costBottom{break-inside:avoid}}
/* M-CROSS_COST_CUTE_V2_SAFE */
.costPage{--cute-ink:#26335c;--cute-blue:#4f8df7;--cute-pink:#ee77a7;--cute-mint:#55b999;--cute-purple:#9b7be8;--cute-peach:#f6aa70;background:radial-gradient(circle at 8% 2%,#fff0f6 0 150px,transparent 151px),radial-gradient(circle at 94% 12%,#e9f4ff 0 170px,transparent 171px),linear-gradient(180deg,#fffdfd,#fff8fb 48%,#f8fbff)!important;color:var(--cute-ink)!important}.costHero{padding:14px 18px;border:1px solid #f2dce8;border-radius:26px;background:rgba(255,255,255,.82);box-shadow:0 12px 30px rgba(100,74,120,.08)}.costHero h1{font-weight:1000;letter-spacing:.08em;color:#29345f;text-shadow:0 2px 0 #fff}.costHeroActions button{border:0!important;border-radius:999px!important;background:#fff!important;color:#59648a!important;box-shadow:0 5px 14px rgba(76,72,110,.12)!important}.costInfoCard{border:1px solid #f0dce8!important;border-radius:24px!important;box-shadow:0 12px 28px rgba(90,70,110,.07)!important}.costInfoCard label span{border-radius:999px!important;background:#f6f2f8!important;color:#6b6280!important}.costInfoCard input{padding:8px 10px;border:1px solid #e5dfeb!important;border-radius:13px!important;background:#fff!important}.costKpis{gap:14px!important}.costKpis article{min-height:124px!important;border-width:2px!important;border-radius:26px!important;box-shadow:0 10px 22px rgba(78,66,100,.08)!important;position:relative;overflow:hidden}.costKpis article:after{content:'';position:absolute;width:70px;height:70px;border-radius:50%;right:-22px;top:-24px;background:rgba(255,255,255,.42)}.costKpis article strong,.costKpis article input{font-size:31px!important}.costSection{border:1px solid #e2dce7!important;border-radius:24px!important;box-shadow:0 12px 28px rgba(86,69,105,.08)!important;overflow:hidden!important}.costSection>header{padding:12px 16px!important;min-height:62px;border-radius:22px 22px 0 0}.costSection.blue>header{background:linear-gradient(135deg,#eaf4ff,#dbeaff)!important;color:#347fea!important}.costSection.pink>header{background:linear-gradient(135deg,#fff0f5,#fddde9)!important;color:#dc5d91!important}.costSection.green>header{background:linear-gradient(135deg,#eafaf4,#d8f2e8)!important;color:#3aa17e!important}.costSection.purple>header{background:linear-gradient(135deg,#f6efff,#e9ddfb)!important;color:#8764d4!important}.costSection.gray>header{background:linear-gradient(135deg,#f4f6fa,#e7ecf3)!important;color:#60708b!important}.costSectionTitle{display:flex!important;align-items:center!important;gap:9px!important;min-width:0}.costSectionIcon{display:grid;place-items:center;width:38px;height:38px;min-width:38px;border-radius:13px;background:rgba(255,255,255,.8);box-shadow:0 4px 12px rgba(70,75,115,.12)}.costSectionIcon svg{width:25px;height:25px;fill:currentColor}.costNumberBadge{display:grid;place-items:center;width:27px;height:27px;min-width:27px;border-radius:50%;background:currentColor;color:#fff;font-size:0}.costNumberBadge:after{content:attr(data-no)}.costSectionTitle .costNumberBadge{font-size:19px!important;background:transparent!important;color:currentColor!important;font-weight:1000}.costSectionTitle strong{font-size:20px!important;font-weight:1000!important;white-space:nowrap}.costSectionTitle small{font-size:13px!important;color:#66708a!important}.sectionTotal{padding:6px 8px;border-radius:18px;background:rgba(255,255,255,.55)}.sectionTotal>strong{font-size:23px!important}.sectionTotal button{border:0!important;border-radius:999px!important;background:#fff!important;color:currentColor!important;box-shadow:0 4px 12px rgba(70,70,100,.10)!important}.costHead{background:#f6f6fa!important;color:#5b6480!important}.costRow{background:#fff}.costRow input{margin:3px;padding:7px 8px!important;border:1px solid transparent!important;border-radius:10px!important}.costRow input:focus{outline:none;border-color:#93bdf9!important;background:#f9fcff!important;box-shadow:0 0 0 3px rgba(79,141,247,.12)}.costRow>button{border-radius:50%!important;color:#bd5277!important}.costEmpty{margin:12px;border:2px dashed #eadbe5;border-radius:18px;background:#fffafd;color:#8c7e91!important}.costBottom>section{border:1px solid #eadfea!important;border-radius:24px!important;box-shadow:0 10px 24px rgba(86,69,105,.07)!important}.costBottom h3{padding:7px 10px;border-radius:13px;background:#f7f3f8}.costBottom textarea{border-radius:16px!important;background:#fffafd!important}.profitLine,.marginLine,.costBottom .grand{border-radius:12px;margin-top:5px;border-bottom:0!important}.costBrand img{border-radius:18px!important;box-shadow:0 8px 20px rgba(211,91,145,.18)}
@media(max-width:820px){.costHero{border-radius:20px}.costInfoCard{border-radius:20px}.costKpis article{border-radius:20px;min-height:104px!important}.costKpis article strong,.costKpis article input{font-size:23px!important}.costSection{border-radius:20px!important}.costSection>header{border-radius:18px 18px 0 0}.costSectionTitle{flex-wrap:wrap}.costSectionTitle strong{font-size:18px!important}.costSectionTitle small{width:100%;padding-left:82px;margin-top:-5px}.costSectionIcon{width:35px;height:35px;min-width:35px}.costNumberBadge{font-size:17px!important}.costTable{overflow:visible!important}.costHead{display:none!important}.costRow{display:grid!important;grid-template-columns:42px minmax(0,1fr) minmax(0,1fr)!important;min-width:0!important;margin:10px;padding:10px;border:1px solid #ebe4ed;border-radius:17px;box-shadow:0 5px 15px rgba(80,66,99,.05)}.costRow>*{border:0!important;padding:7px!important;min-width:0}.costRow>span{grid-column:1;grid-row:1/3;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#f1f5fb;color:#65728b}.costRow>input:nth-of-type(1){grid-column:2/-1}.costRow>input:nth-of-type(2){grid-column:2/-1}.costRow>strong{grid-column:2/-1;text-align:right;font-size:18px;color:#d85e8f}.costRow>button{grid-column:3;justify-self:end}.taxIncluded{grid-column:2/-1!important}.costBottom{gap:10px!important}}
@media print{@page{size:A4 landscape;margin:5mm}.costPage{zoom:.54!important;padding:0!important;background:#fff!important;width:100%!important}.costHero{padding:4px 8px!important;margin:0 0 4px!important;border-radius:8px!important;box-shadow:none!important}.costHero h1{font-size:22px!important}.costBrand img{width:38px!important;height:38px!important}.costInfoCard{padding:5px!important;gap:2px 5px!important;border-radius:7px!important;box-shadow:none!important}.costInfoCard span,.costInfoCard input{padding:2px 4px!important;font-size:8px!important}.costKpis{gap:5px!important;margin:5px 0!important}.costKpis article{min-height:58px!important;padding:3px!important;border-radius:8px!important;box-shadow:none!important}.costKpis article span{font-size:8px!important}.costKpis article strong,.costKpis article input{font-size:17px!important}.costKpis article small{font-size:7px!important}.costSection{margin:4px 0!important;border-radius:7px!important;box-shadow:none!important;break-inside:avoid}.costSection>header{min-height:28px!important;padding:3px 6px!important;border-radius:6px 6px 0 0!important}.costSectionIcon{width:22px!important;height:22px!important;min-width:22px!important;border-radius:6px!important}.costSectionIcon svg{width:15px!important;height:15px!important}.costNumberBadge{font-size:12px!important;width:18px!important;min-width:18px!important}.costSectionTitle strong{font-size:11px!important}.costSectionTitle small{font-size:7px!important}.sectionTotal{padding:1px 4px!important}.sectionTotal>strong{font-size:12px!important}.costHead,.costRow{grid-template-columns:34px 1.4fr 1fr 55px 48px 68px 75px 1fr 35px!important;min-width:0!important;font-size:7px!important}.costHead span,.costRow>*{padding:2px!important}.costRow input{margin:0!important;padding:1px!important;font-size:7px!important}.costEmpty{display:none!important}.costBottom{grid-template-columns:1.2fr .9fr .8fr!important;gap:5px!important;margin-top:5px!important}.costBottom>section{padding:5px!important;border-radius:7px!important;box-shadow:none!important}.costBottom h3{margin:0 0 3px!important;padding:2px!important;font-size:9px!important}.costBottom textarea{min-height:45px!important;padding:3px!important;font-size:7px!important}.costBottom section>div{padding:2px!important;font-size:8px!important}.costBottom .grand,.profitLine,.marginLine{font-size:10px!important}.costHeroActions,.sectionTotal button,.costRow>button{display:none!important}body{overflow:visible!important}}
