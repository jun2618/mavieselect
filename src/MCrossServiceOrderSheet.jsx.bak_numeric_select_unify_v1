import { useState } from 'react'
import './MCrossServiceOrderSheet.css'

const money=value=>'¥'+Math.round(Number(value)||0).toLocaleString('ja-JP')
const qty=value=>{const n=Number(value);if(!Number.isFinite(n))return '';return String(Math.round(n*100)/100)}

export default function MCrossServiceOrderSheet({orderDraft,setOrderDraft,propertyName='',unit='',address='',workName='',onSave,onChooseContractor}){
 /* M-CROSS_SERVICE_BULK_RATE_MODAL_V1_SAFE */
 const defaults=[['cross','クロス施工','㎡'],['cf','CF施工','㎡'],['soft','ソフト巾木','枚'],['floorTrim','床見切り','本'],['wallBase','壁下地処理','式'],['floorBase','床下地処理','式'],['floorTile','フロアタイル貼り','㎡']]
 const [showBulkRates,setShowBulkRates]=useState(false)
 const [bulkRates,setBulkRates]=useState(()=>Object.fromEntries(defaults.map(([key])=>[key,''])))
 const [customRates,setCustomRates]=useState([])
 const [customDraft,setCustomDraft]=useState({label:'',unit:'㎡',rate:''})
 const applyBulkRates=()=>{setOrderDraft(previous=>({...previous,items:(previous.items||[]).map(item=>{const fixed=bulkRates[item.category];if(fixed!==''&&fixed!=null)return {...item,orderRate:Math.max(0,Number(fixed)||0)};const text=[item.label,item.productCode,item.memo].filter(Boolean).join(' ').toLowerCase();const custom=customRates.find(row=>String(row.label||'').trim()&&row.rate!==''&&text.includes(String(row.label).trim().toLowerCase()));return custom?{...item,orderRate:Math.max(0,Number(custom.rate)||0)}:item})}));setShowBulkRates(false)}

 const items=Array.isArray(orderDraft?.items)?orderDraft.items:[]
 const subtotal=items.reduce((sum,item)=>sum+(Number(item.orderQuantity)||0)*(Number(item.orderRate)||0),0)
 const tax=Math.round(subtotal*.1)
 const update=(index,patch)=>setOrderDraft(previous=>({...previous,items:previous.items.map((item,i)=>i===index?{...item,...patch}:item)}))
 const remove=index=>setOrderDraft(previous=>({...previous,items:previous.items.filter((_,i)=>i!==index)}))
 return <section className="mcrossServiceSheet">
  <div className="mcrossServiceUnsavedTop"><div className="mcrossServiceUnsavedBadge">● 未保存　下書き保存してください</div><button type="button" className="mcrossServiceCloseButton" onClick={()=>{if(!window.confirm("この発注書はまだ下書き保存されていません。\n\n保存せず閉じますか？"))return;setOrderDraft(null)}}>× 閉じる</button></div><header className="mcrossServiceSheetHead"><div className="mcrossServiceSheetBrand"><strong>M-Cross</strong><small>MavieSelect</small></div><h2>施 工 発 注 書</h2><div className="mcrossServiceSheetCompany"><strong>株式会社 MavieSelect</strong><span>〒060-0007</span><span>札幌市中央区北7条西22丁目1-12-201</span><span>TEL 011-699-6492　FAX 011-699-6493</span></div></header>
  <section className="mcrossServiceSheetMeta"><div><span>物件名</span><strong>{propertyName}</strong></div><div><span>号室</span><strong>{unit?String(unit).replace(/号室$/,'')+'号室':''}</strong></div><div><span>住所</span><strong>{address}</strong></div><div><span>工事名</span><strong>{workName||'原状回復工事'}</strong></div><div className="wide"><span>発注先</span><strong>{orderDraft?.contractor||'発注先未選択'}</strong></div></section>
  {/* M-CROSS_SERVICE_ORDER_CONTROLS_V6_SAFE */}
  <section className="mcrossServiceSheetControls">
    <button type="button" className="contractor" onClick={onChooseContractor}>🔎 {orderDraft?.contractor||'協力業者を選択'}</button>
    {['cross','cf'].map(category=>{const group=items.filter(item=>item.category===category);if(!group.length)return null;const current=group[0]?.factor??1;return <div className="factor" key={category}><strong>{category==='cross'?'クロス':'CF'}</strong><span>{group.length}項目</span><div>{[1,.9,.85].map(value=><button type="button" key={value} className={current===value?'active':''} onClick={()=>setOrderDraft(previous=>({...previous,items:previous.items.map(item=>item.category===category?{...item,factor:value,orderQuantity:Math.round((Number(item.sourceQuantity)||0)*value*100)/100}:item)}))}>×{value.toFixed(2)}</button>)}</div></div>})}
    <button type="button" className="bulkRate" onClick={()=>setShowBulkRates(true)}>💰 施工単価をまとめて入力</button>
  </section>
  {showBulkRates&&<div className="mcrossServiceBulkBackdrop" role="dialog" aria-modal="true"><section className="mcrossServiceBulkModal"><header><div><small>UNIT PRICE</small><h3>施工単価をまとめて入力</h3></div><button type="button" onClick={()=>setShowBulkRates(false)}>× 閉じる</button></header><div className="mcrossServiceBulkGrid">{defaults.map(([key,label,u])=><label key={key}><span>{label}</span><div><input onFocus={e=>{requestAnimationFrame(()=>e.currentTarget.select())}} inputMode="decimal" type="number" min="0" step="1" value={bulkRates[key]} onChange={e=>setBulkRates(v=>({...v,[key]:e.target.value}))} placeholder="未設定"/><b>円/{u}</b></div></label>)}</div><section className="mcrossServiceBulkCustom"><strong>＋施工項目を追加</strong><div className="add"><input value={customDraft.label} onChange={e=>setCustomDraft(v=>({...v,label:e.target.value}))} placeholder="例：Pタイル貼り"/><input value={customDraft.unit} onChange={e=>setCustomDraft(v=>({...v,unit:e.target.value}))} placeholder="㎡"/><input onFocus={e=>{requestAnimationFrame(()=>e.currentTarget.select())}} inputMode="decimal" type="number" min="0" value={customDraft.rate} onChange={e=>setCustomDraft(v=>({...v,rate:e.target.value}))} placeholder="単価"/><button type="button" onClick={()=>{const label=customDraft.label.trim();if(!label)return;setCustomRates(v=>[...v,{id:Date.now(),...customDraft,label}]);setCustomDraft({label:'',unit:'㎡',rate:''})}}>追加</button></div>{customRates.map(row=><div className="row" key={row.id}><strong>{row.label}</strong><span>円/{row.unit||'式'}</span><input onFocus={e=>{requestAnimationFrame(()=>e.currentTarget.select())}} inputMode="decimal" type="number" min="0" value={row.rate} onChange={e=>setCustomRates(v=>v.map(x=>x.id===row.id?{...x,rate:e.target.value}:x))}/><button type="button" onClick={()=>setCustomRates(v=>v.filter(x=>x.id!==row.id))}>削除</button></div>)}</section><footer><button type="button" onClick={()=>setShowBulkRates(false)}>キャンセル</button><button type="button" className="apply" onClick={applyBulkRates}>施工明細へ反映</button></footer></section></div>}
  <div className="mcrossServiceSheetTable"><div className="mcrossServiceSheetRow head"><span>No.</span><span>工事項目</span><span>仕様・品番</span><span>見積→発注</span><span>単位</span><span>発注単価</span><span>発注金額</span><span>操作</span></div>{items.map((item,index)=><div className="mcrossServiceSheetRow" key={(item.id||'row')+'-'+index}><span>{index+1}</span><span className="work">{item.label}</span><span>{item.productCode||item.memo||''}</span><span className="compare">{qty(item.sourceQuantity)} → {qty(item.orderQuantity)}</span><span>{item.unit}</span><span className="rate"><input onFocus={e=>{requestAnimationFrame(()=>e.currentTarget.select())}} inputMode="decimal" type="number" min="0" step="1" value={item.orderRate??''} onChange={e=>update(index,{orderRate:e.target.value===''?'':Math.max(0,Number(e.target.value)||0)})}/></span><span className="amount">{item.orderRate===''||item.orderRate==null?'未設定':money((Number(item.orderQuantity)||0)*(Number(item.orderRate)||0))}</span><span><button type="button" className="mcrossServiceSheetDelete" onClick={()=>remove(index)}>×</button></span></div>)}</div>
  <footer className="mcrossServiceSheetFoot"><div className="mcrossServiceSheetNotes"><strong>備考</strong><textarea placeholder="必要な場合に入力"/></div><div className="mcrossServiceSheetTotals"><div><span>小計</span><strong>{money(subtotal)}</strong></div><div><span>消費税（10%）</span><strong>{money(tax)}</strong></div><div className="grand"><span>合計</span><strong>{money(subtotal+tax)}</strong></div></div></footer>
  <div className="mcrossServiceSheetActions"><button type="button" onClick={onSave}>📦 下書き保存</button></div>
 </section>
}
