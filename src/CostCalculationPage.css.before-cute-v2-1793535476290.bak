.costPage{--navy:#24243f;--pink:#e95d96;--green:#13815a;min-height:100vh;padding:16px;background:linear-gradient(#fffaf8,#fff);color:var(--navy);font-family:"Zen Maru Gothic","Yu Gothic",Meiryo,sans-serif}.costHero{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin-bottom:12px}.costBrand{display:flex;align-items:center;gap:8px;color:#d95291}.costBrand img{width:54px;height:54px;border-radius:14px}.costBrand div{display:grid}.costBrand small{font-size:15px}.costBrand strong{font-size:24px}.costHero h1{margin:0;font-size:34px;letter-spacing:.08em}.costHeroActions{display:flex;justify-content:flex-end;gap:8px}.costHeroActions button,.costSection button{min-height:42px;padding:8px 13px;border:1px solid #a7b5cb;border-radius:11px;background:#fff;color:var(--navy);font:inherit;font-weight:900}.costInfoCard{display:grid;grid-template-columns:110px 1fr 110px 1fr;gap:6px 12px;padding:14px;border:1px solid #ecdde0;border-radius:14px;background:#fff;box-shadow:0 5px 18px rgba(50,40,70,.06)}.costInfoCard label{display:contents}.costInfoCard label span{padding:7px 9px;border-radius:7px;background:#eef1f5;font-weight:900}.costInfoCard input{min-width:0;border:0;border-bottom:1px solid #d8dde5;background:transparent;font:inherit}.costKpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:12px 0}.costKpis article{min-height:116px;display:grid;place-items:center;padding:10px;border:1px solid;border-radius:12px}.costKpis article span{font-weight:900}.costKpis article strong,.costKpis article input{width:100%;border:0;background:transparent;text-align:center;font-size:30px;font-weight:900;color:inherit}.costKpis .estimate{background:#fde8ef;border-color:#f4c3d4;color:#bd2c5a}.costKpis .cost{background:#e2f5ee;border-color:#bde3d3;color:#13815a}.costKpis .profit{background:#e4f0ff;border-color:#bfd8f7;color:#1460c5}.costKpis .margin{background:#fff0e3;border-color:#f0ceb1;color:#994617}.costSection{margin:12px 0;border:1px solid #c7ced9;border-radius:13px;background:#fff;overflow:hidden}.costSection>header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:9px 12px}.costSection>header>div:first-child{display:flex;align-items:center;gap:8px}.costSection>header b{font-size:22px}.costSection>header strong{font-size:18px}.costSection>header small{font-weight:800}.costSection.blue>header{background:#e4f0ff;color:#1460c5}.costSection.pink>header{background:#fde8ef;color:#bd2c5a}.costSection.green>header{background:#e2f5ee;color:#13815a}.costSection.purple>header{background:#f0e5ff;color:#6031a5}.costSection.gray>header{background:#eef1f5;color:#46536a}.sectionTotal{display:flex;align-items:center;gap:12px}.sectionTotal>strong{font-size:22px}.costTable{overflow:auto}.costHead,.costRow{display:grid;grid-template-columns:52px minmax(180px,1.3fr) minmax(150px,1fr) 80px 68px 105px 115px minmax(150px,1fr) 56px;min-width:1000px}.costHead{background:#eef1f5;font-weight:900}.costHead span,.costRow>*{padding:8px;border-right:1px solid #c7ced9;border-top:1px solid #c7ced9}.costHead span{text-align:center}.costRow input{min-width:0;border:0;background:transparent;font:inherit}.costRow>span,.costRow>strong{text-align:right}.costRow>button{border:0;background:transparent}.costEmpty{padding:22px;text-align:center;color:#687083}.taxIncluded{grid-column:7/9;display:flex!important;gap:8px!important;align-items:center}.taxIncluded input{border-bottom:1px solid #ccc}.costBottom{display:grid;grid-template-columns:1.2fr .85fr .7fr;gap:12px;margin-top:14px}.costBottom>section{padding:12px;border:1px solid #d7dde6;border-radius:13px;background:#fff}.costBottom h3{margin:0 0 10px;font-size:17px}.costBottom textarea{width:100%;min-height:180px;box-sizing:border-box;border:1px solid #d8dde5;border-radius:10px;padding:10px;font:inherit}.costBottom section>div{display:flex;justify-content:space-between;padding:7px;border-bottom:1px solid #d8dde5}.costBottom .grand{font-size:20px;font-weight:900;background:#eef1f5}.profitLine{background:#fde8ef;color:#bd2c5a;font-size:18px;font-weight:900}.marginLine{background:#e4f0ff;color:#1460c5;font-size:18px;font-weight:900}@media(max-width:820px){.costPage{padding:8px}.costHero{grid-template-columns:1fr auto}.costHero h1{grid-column:1/-1;grid-row:1;text-align:center;font-size:27px}.costBrand{grid-row:2}.costHeroActions{grid-row:2}.costInfoCard{grid-template-columns:92px 1fr}.costKpis{grid-template-columns:1fr 1fr}.costSection>header{align-items:stretch;flex-direction:column}.sectionTotal{display:grid;grid-template-columns:auto 1fr}.sectionTotal button{grid-column:1/-1}.costBottom{grid-template-columns:1fr}.costBrand small{font-size:11px}.costBrand strong{font-size:18px}}@media print{.costHeroActions,.costSection button,.costRow>button{display:none!important}.costPage{padding:0;background:#fff}.costSection{break-inside:avoid}.costBottom{break-inside:avoid}}