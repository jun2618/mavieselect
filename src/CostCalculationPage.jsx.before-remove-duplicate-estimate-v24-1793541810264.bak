import React, {useEffect, useMemo, useState} from 'react'
import './CostCalculationPage.css'

const yen=n=>'¥'+Math.round(Number(n)||0).toLocaleString('ja-JP')
const qty=n=>Number.isFinite(Number(n))?Number(n):0
const TYPES=[
  {key:'internal',title:'① 自社作業',sub:'自社スタッフの作業',icon:'●',tone:'blue',headers:['作業内容','作業者']},
  {key:'service',title:'② 施工業者・職人',sub:'外注工事の発注',icon:'◆',tone:'pink',headers:['工種','業者名']},
  {key:'material',title:'③ 材料発注',sub:'問屋・登録業者からの購入',icon:'■',tone:'green',headers:['商品名','発注先']},
  {key:'retail',title:'④ 店頭・ネット購入',sub:'ホームセンター・Amazon等',icon:'◆',tone:'purple',headers:['商品名','購入先']},
  {key:'expense',title:'⑤ 現場経費',sub:'ゴミ処理・駐車場・その他',icon:'▣',tone:'gray',headers:['項目','内容']}
]

/* M-CROSS_COST_CUTE_V2_SAFE */

/* M-CROSS_COST_CUTE_V3_SAFE */
const KpiIcon=({type})=>{const p={viewBox:'0 0 64 64','aria-hidden':true};if(type==='estimate')return <svg {...p}><rect x="12" y="8" width="38" height="48" rx="7"/><path d="M21 22h21M21 31h19M21 40h14" fill="none" stroke="#fff" strokeWidth="5" strokeLinecap="round"/><circle cx="48" cy="48" r="12"/><path d="M48 41v14m-6-10h12" stroke="#fff" strokeWidth="3"/></svg>;if(type==='cost')return <svg {...p}><ellipse cx="25" cy="20" rx="15" ry="7"/><path d="M10 20v10c0 4 7 7 15 7s15-3 15-7V20M10 30v10c0 4 7 7 15 7 4 0 8-1 11-3"/><ellipse cx="44" cy="41" rx="12" ry="6"/><path d="M32 41v9c0 3 5 6 12 6s12-3 12-6v-9"/></svg>;if(type==='profit')return <svg {...p}><rect x="9" y="38" width="10" height="18" rx="3"/><rect x="27" y="27" width="10" height="29" rx="3"/><rect x="45" y="16" width="10" height="40" rx="3"/><path d="M12 29c13-2 25-11 39-21l-2 10m2-10-10 2" fill="none" stroke="currentColor" strokeWidth="5" strokeLinecap="round" strokeLinejoin="round"/></svg>;return <svg {...p}><path d="M32 7a25 25 0 1 0 25 25H32z"/><path d="M37 7v20h20A25 25 0 0 0 37 7z" opacity=".55"/></svg>}

const CostIcon=({type})=>{const common={viewBox:'0 0 48 48','aria-hidden':true,focusable:'false'};if(type==='internal')return <svg {...common}><circle cx="24" cy="15" r="8"/><path d="M9 40c1-11 6-16 15-16s14 5 15 16z"/></svg>;if(type==='service')return <svg {...common}><path d="M29 7a11 11 0 0 0-9 15L8 34a4 4 0 0 0 6 6l12-12a11 11 0 0 0 15-9l-8 5-7-7z"/></svg>;if(type==='material')return <svg {...common}><path d="M8 15 24 7l16 8-16 8zM8 15v19l16 8V23zm32 0v19l-16 8V23z"/></svg>;if(type==='retail')return <svg {...common}><path d="M10 16h28l-3 25H13z"/><path d="M17 18c0-8 14-8 14 0" fill="none" stroke="currentColor" strokeWidth="4"/></svg>;return <svg {...common}><rect x="8" y="8" width="32" height="32" rx="9"/><path d="M19 35V13h8a8 8 0 0 1 0 16h-8m0-8h8" fill="none" stroke="#fff" strokeWidth="4"/></svg>}

const blankRow=()=>({id:'cost-'+Date.now()+'-'+Math.random().toString(36).slice(2,7),name:'',party:'',quantity:1,unit:'式',rate:'',memo:'',orderRef:'',date:'',taxIncluded:''})
/* M-CROSS_COST_ROWS_ONEPAGE_PRINT_V10_SAFE */
const DEFAULT_COST_ROWS={internal:6,service:6,material:8,retail:6,expense:3}
const makeInitialRows=()=>Object.fromEntries(TYPES.map(t=>[t.key,Array.from({length:DEFAULT_COST_ROWS[t.key]||3},()=>blankRow())]))
const ensureDefaultRows=source=>Object.fromEntries(TYPES.map(t=>{const current=Array.isArray(source?.[t.key])?source[t.key]:[];const minimum=DEFAULT_COST_ROWS[t.key]||3;return [t.key,current.length>=minimum?current:[...current,...Array.from({length:minimum-current.length},()=>blankRow())]]}))


export default function CostCalculationPage({onBack}){
  const [info,setInfo]=useState({propertyName:'',unit:'',address:'',company:'',workName:'',staff:'町田',period:'',estimate:0,memo:''})
  const [rows,setRows]=useState(()=>makeInitialRows())
  useEffect(()=>{try{const v=JSON.parse(localStorage.getItem('mcross_cost_calculation_v1')||'null');if(v?.info)setInfo(v.info);if(v?.rows)setRows(ensureDefaultRows(v.rows))}catch{}},[])
  useEffect(()=>{try{localStorage.setItem('mcross_cost_calculation_v1',JSON.stringify({info,rows}))}catch{}},[info,rows])
  const subtotal=key=>(rows[key]||[]).reduce((s,r)=>s+(key==='retail'&&r.taxIncluded!==''?Math.floor(qty(r.taxIncluded)/1.1):qty(r.quantity)*qty(r.rate)),0)
  const costs=useMemo(()=>Object.fromEntries(TYPES.map(t=>[t.key,subtotal(t.key)])),[rows])
  const totalCost=Object.values(costs).reduce((a,b)=>a+b,0), profit=qty(info.estimate)-totalCost, margin=qty(info.estimate)?profit/qty(info.estimate)*100:0
  const update=(key,id,field,value)=>setRows(p=>({...p,[key]:(p[key]||[]).map(r=>r.id===id?{...r,[field]:value}:r)}))
  const add=key=>setRows(p=>({...p,[key]:[...(p[key]||[]),blankRow()]}))
  const remove=(key,id)=>setRows(p=>({...p,[key]:(p[key]||[]).filter(r=>r.id!==id)}))
  const importOrders=()=>{try{const all=JSON.parse(localStorage.getItem('mcross_purchase_orders_v1')||'[]');const matched=(Array.isArray(all)?all:[]).filter(o=>(!info.propertyName||o.propertyName===info.propertyName)&&(!info.unit||String(o.unit)===String(info.unit)));const next={service:[],material:[]};matched.forEach(o=>(o.items||[]).forEach((x,i)=>next[o.orderMode==='material'?'material':'service'].push({id:'import-'+o.id+'-'+i,name:x.label||x.productCode||'',party:o.contractorName||'',quantity:x.orderQuantity??x.quantity??1,unit:x.unit||'式',rate:x.orderRate??x.rate??'',memo:x.memo||'',orderRef:o.status||'発注書'})));setRows(p=>({...p,service:next.service,material:next.material}));alert('施工・材料発注書から原価を取り込みました。')}catch{alert('発注書を読み込めませんでした。')}}
  /* M-CROSS_COST_AUTO_PRINT_DENSITY_V17_SAFE */
  const visibleRowCount=Object.values(rows).reduce((sum,list)=>sum+(Array.isArray(list)?list.length:0),0)
  const printDensity=visibleRowCount<=29?'printComfort':visibleRowCount<=36?'printCompact':'printDense'
  return <div className={'costPage '+printDensity} data-row-count={visibleRowCount}>
    <header className="costHero costHeroSimple">{/* M-CROSS_COST_SIMPLE_TOP_V20_SAFE */}<h1>原価計算書</h1><div className="costHeroActions"><button onClick={onBack}>← 戻る</button><button onClick={()=>window.print()}>▣ 印刷 / PDF出力</button></div></header>
    <section className="costInfoCard costInfoCompact costInfoMinimal"><label className="costPropertyCombined"><span>物件</span><div><input className="propertyName" value={info.propertyName} onChange={e=>setInfo({...info,propertyName:e.target.value})} placeholder="物件名"/><input className="propertyUnit" value={info.unit} onChange={e=>setInfo({...info,unit:e.target.value})} placeholder="号室"/></div></label><label><span>担当者</span><input value={info.staff} onChange={e=>setInfo({...info,staff:e.target.value})}/></label><label><span>完了日</span><input type="date" value={info.period||''} onChange={e=>setInfo({...info,period:e.target.value})}/></label></section>
    <section className="costKpis">{/* M-CROSS_COST_KPIS_FOUR_ACROSS_V23_SAFE */}<article className="estimate"><i className="kpiArt"><KpiIcon type="estimate"/></i><span>見積金額（税抜）</span><div className="estimateAmountEditor"><span className="estimateYen">¥</span><input type="number" value={info.estimate===''||info.estimate==null?0:info.estimate} onFocus={e=>e.currentTarget.select()} onChange={e=>setInfo({...info,estimate:e.target.value})}/></div><small>税込 {yen(qty(info.estimate)*1.1)}</small></article>
      <article className="estimate"><i className="kpiArt"><KpiIcon type="estimate"/></i><span>見積金額（税抜）</span><input type="number" value={info.estimate||''} onChange={e=>setInfo({...info,estimate:e.target.value})}/><small>税込 {yen(qty(info.estimate)*1.1)}</small></article>
      <article className="cost"><i className="kpiArt"><KpiIcon type="cost"/></i><span>原価合計（税抜）</span><strong>{yen(totalCost)}</strong></article>
      <article className="profit"><i className="kpiArt"><KpiIcon type="profit"/></i><span>粗利益（税抜）</span><strong>{yen(profit)}</strong></article>
      <article className="margin"><i className="kpiArt"><KpiIcon type="margin"/></i><span>粗利率</span><strong>{margin.toFixed(1)}%</strong></article>
    </section>
    {TYPES.map(t=><section className={'costSection '+t.tone} key={t.key}>
      <header><div className="costSectionTitle"><span className="costSectionIcon"><CostIcon type={t.key}/></span><span className="costNumberBadge">{t.title.match(/[①②③④⑤]/)?.[0]}</span><strong>{t.title.replace(/^[①②③④⑤]\s*/, '')}</strong><small>（{t.sub}）</small></div><div className="sectionTotal"><span>小計</span><strong>{yen(costs[t.key])}</strong><button onClick={()=>add(t.key)}>＋ 行を追加</button>{(t.key==='service'||t.key==='material')&&<button onClick={importOrders}>＋ 発注書から取り込む</button>}</div></header>
      <div className="costTable"><div className="costHead"><span>No.</span><span>{t.headers[0]}</span><span>{t.headers[1]}</span><span>数量</span><span>単位</span><span>単価</span><span>金額</span><span>税込金額</span><span>操作</span></div>
      {(rows[t.key]||[]).length===0?<p className="costEmpty">まだ明細がありません。「行を追加」から入力できます。</p>:(rows[t.key]||[]).map((r,i)=>{const amount=t.key==='retail'&&r.taxIncluded!==''?Math.floor(qty(r.taxIncluded)/1.1):qty(r.quantity)*qty(r.rate);return <div className="costRow" key={r.id}><span>{i+1}</span><input value={r.name} onChange={e=>update(t.key,r.id,'name',e.target.value)}/><input value={r.party} onChange={e=>update(t.key,r.id,'party',e.target.value)}/><input type="number" value={r.quantity} onChange={e=>update(t.key,r.id,'quantity',e.target.value)}/><input value={r.unit} onChange={e=>update(t.key,r.id,'unit',e.target.value)}/><input type="number" value={r.rate} onChange={e=>update(t.key,r.id,'rate',e.target.value)}/>{/* M-CROSS_COST_TAX_INCLUDED_COLUMN_V8_SAFE */}<strong>{yen(amount)}</strong><div className="taxIncludedCell">{t.key==='retail'?<input type="number" value={r.taxIncluded} onChange={e=>update(t.key,r.id,'taxIncluded',e.target.value)} placeholder="税込金額"/>:<strong>{yen(amount*1.1)}</strong>}</div><button onClick={()=>remove(t.key,r.id)}>▣</button></div>})}</div>
    </section>)}
    <section className="costPrintOnly"><div className="costPrintGroups">{TYPES.map(t=>{const used=(rows[t.key]||[]).filter(r=>String(r.name||'').trim()||String(r.party||'').trim()||qty(r.rate)||qty(r.taxIncluded));return <article key={t.key}><header><span><CostIcon type={t.key}/></span><b>{t.title}</b><strong>{yen(costs[t.key])}</strong></header>{used.length===0?<small>明細なし</small>:used.map((r,i)=>{const amount=t.key==='retail'&&r.taxIncluded!==''?Math.floor(qty(r.taxIncluded)/1.1):qty(r.quantity)*qty(r.rate);return <div key={r.id||i}><em>{i+1}</em><span>{r.name||'未入力'}</span><span>{r.party||''}</span><span>{qty(r.quantity)}{r.unit||''}</span><span>{yen(r.rate)}</span><b>{yen(amount)}</b></div>})}</article>})}</div></section>{/* M-CROSS_COST_REMOVE_BOTTOM_V21_SAFE: bottom memo/summary/profit blocks removed; totals remain in top KPI + section subtotals */}
  </div>
}
