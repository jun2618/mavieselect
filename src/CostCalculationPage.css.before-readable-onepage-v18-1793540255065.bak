.costPage{--navy:#24243f;--pink:#e95d96;--green:#13815a;min-height:100vh;padding:16px;background:linear-gradient(#fffaf8,#fff);color:var(--navy);font-family:"Zen Maru Gothic","Yu Gothic",Meiryo,sans-serif}.costHero{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin-bottom:12px}.costBrand{display:flex;align-items:center;gap:8px;color:#d95291}.costBrand img{width:54px;height:54px;border-radius:14px}.costBrand div{display:grid}.costBrand small{font-size:15px}.costBrand strong{font-size:24px}.costHero h1{margin:0;font-size:34px;letter-spacing:.08em}.costHeroActions{display:flex;justify-content:flex-end;gap:8px}.costHeroActions button,.costSection button{min-height:42px;padding:8px 13px;border:1px solid #a7b5cb;border-radius:11px;background:#fff;color:var(--navy);font:inherit;font-weight:900}.costInfoCard{display:grid;grid-template-columns:110px 1fr 110px 1fr;gap:6px 12px;padding:14px;border:1px solid #ecdde0;border-radius:14px;background:#fff;box-shadow:0 5px 18px rgba(50,40,70,.06)}.costInfoCard label{display:contents}.costInfoCard label span{padding:7px 9px;border-radius:7px;background:#eef1f5;font-weight:900}.costInfoCard input{min-width:0;border:0;border-bottom:1px solid #d8dde5;background:transparent;font:inherit}.costKpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:12px 0}.costKpis article{min-height:116px;display:grid;place-items:center;padding:10px;border:1px solid;border-radius:12px}.costKpis article span{font-weight:900}.costKpis article strong,.costKpis article input{width:100%;border:0;background:transparent;text-align:center;font-size:30px;font-weight:900;color:inherit}.costKpis .estimate{background:#fde8ef;border-color:#f4c3d4;color:#bd2c5a}.costKpis .cost{background:#e2f5ee;border-color:#bde3d3;color:#13815a}.costKpis .profit{background:#e4f0ff;border-color:#bfd8f7;color:#1460c5}.costKpis .margin{background:#fff0e3;border-color:#f0ceb1;color:#994617}.costSection{margin:12px 0;border:1px solid #c7ced9;border-radius:13px;background:#fff;overflow:hidden}.costSection>header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:9px 12px}.costSection>header>div:first-child{display:flex;align-items:center;gap:8px}.costSection>header b{font-size:22px}.costSection>header strong{font-size:18px}.costSection>header small{font-weight:800}.costSection.blue>header{background:#e4f0ff;color:#1460c5}.costSection.pink>header{background:#fde8ef;color:#bd2c5a}.costSection.green>header{background:#e2f5ee;color:#13815a}.costSection.purple>header{background:#f0e5ff;color:#6031a5}.costSection.gray>header{background:#eef1f5;color:#46536a}.sectionTotal{display:flex;align-items:center;gap:12px}.sectionTotal>strong{font-size:22px}.costTable{overflow:auto}.costHead,.costRow{display:grid;grid-template-columns:52px minmax(180px,1.3fr) minmax(150px,1fr) 80px 68px 105px 115px minmax(150px,1fr) 56px;min-width:1000px}.costHead{background:#eef1f5;font-weight:900}.costHead span,.costRow>*{padding:8px;border-right:1px solid #c7ced9;border-top:1px solid #c7ced9}.costHead span{text-align:center}.costRow input{min-width:0;border:0;background:transparent;font:inherit}.costRow>span,.costRow>strong{text-align:right}.costRow>button{border:0;background:transparent}.costEmpty{padding:22px;text-align:center;color:#687083}.taxIncluded{grid-column:7/9;display:flex!important;gap:8px!important;align-items:center}.taxIncluded input{border-bottom:1px solid #ccc}.costBottom{display:grid;grid-template-columns:1.2fr .85fr .7fr;gap:12px;margin-top:14px}.costBottom>section{padding:12px;border:1px solid #d7dde6;border-radius:13px;background:#fff}.costBottom h3{margin:0 0 10px;font-size:17px}.costBottom textarea{width:100%;min-height:180px;box-sizing:border-box;border:1px solid #d8dde5;border-radius:10px;padding:10px;font:inherit}.costBottom section>div{display:flex;justify-content:space-between;padding:7px;border-bottom:1px solid #d8dde5}.costBottom .grand{font-size:20px;font-weight:900;background:#eef1f5}.profitLine{background:#fde8ef;color:#bd2c5a;font-size:18px;font-weight:900}.marginLine{background:#e4f0ff;color:#1460c5;font-size:18px;font-weight:900}@media(max-width:820px){.costPage{padding:8px}.costHero{grid-template-columns:1fr auto}.costHero h1{grid-column:1/-1;grid-row:1;text-align:center;font-size:27px}.costBrand{grid-row:2}.costHeroActions{grid-row:2}.costInfoCard{grid-template-columns:92px 1fr}.costKpis{grid-template-columns:1fr 1fr}.costSection>header{align-items:stretch;flex-direction:column}.sectionTotal{display:grid;grid-template-columns:auto 1fr}.sectionTotal button{grid-column:1/-1}.costBottom{grid-template-columns:1fr}.costBrand small{font-size:11px}.costBrand strong{font-size:18px}}@media print{.costHeroActions,.costSection button,.costRow>button{display:none!important}.costPage{padding:0;background:#fff}.costSection{break-inside:avoid}.costBottom{break-inside:avoid}}
/* M-CROSS_COST_CUTE_V2_SAFE */
.costPage{--cute-ink:#26335c;--cute-blue:#4f8df7;--cute-pink:#ee77a7;--cute-mint:#55b999;--cute-purple:#9b7be8;--cute-peach:#f6aa70;background:radial-gradient(circle at 8% 2%,#fff0f6 0 150px,transparent 151px),radial-gradient(circle at 94% 12%,#e9f4ff 0 170px,transparent 171px),linear-gradient(180deg,#fffdfd,#fff8fb 48%,#f8fbff)!important;color:var(--cute-ink)!important}.costHero{padding:14px 18px;border:1px solid #f2dce8;border-radius:26px;background:rgba(255,255,255,.82);box-shadow:0 12px 30px rgba(100,74,120,.08)}.costHero h1{font-weight:1000;letter-spacing:.08em;color:#29345f;text-shadow:0 2px 0 #fff}.costHeroActions button{border:0!important;border-radius:999px!important;background:#fff!important;color:#59648a!important;box-shadow:0 5px 14px rgba(76,72,110,.12)!important}.costInfoCard{border:1px solid #f0dce8!important;border-radius:24px!important;box-shadow:0 12px 28px rgba(90,70,110,.07)!important}.costInfoCard label span{border-radius:999px!important;background:#f6f2f8!important;color:#6b6280!important}.costInfoCard input{padding:8px 10px;border:1px solid #e5dfeb!important;border-radius:13px!important;background:#fff!important}.costKpis{gap:14px!important}.costKpis article{min-height:124px!important;border-width:2px!important;border-radius:26px!important;box-shadow:0 10px 22px rgba(78,66,100,.08)!important;position:relative;overflow:hidden}.costKpis article:after{content:'';position:absolute;width:70px;height:70px;border-radius:50%;right:-22px;top:-24px;background:rgba(255,255,255,.42)}.costKpis article strong,.costKpis article input{font-size:31px!important}.costSection{border:1px solid #e2dce7!important;border-radius:24px!important;box-shadow:0 12px 28px rgba(86,69,105,.08)!important;overflow:hidden!important}.costSection>header{padding:12px 16px!important;min-height:62px;border-radius:22px 22px 0 0}.costSection.blue>header{background:linear-gradient(135deg,#eaf4ff,#dbeaff)!important;color:#347fea!important}.costSection.pink>header{background:linear-gradient(135deg,#fff0f5,#fddde9)!important;color:#dc5d91!important}.costSection.green>header{background:linear-gradient(135deg,#eafaf4,#d8f2e8)!important;color:#3aa17e!important}.costSection.purple>header{background:linear-gradient(135deg,#f6efff,#e9ddfb)!important;color:#8764d4!important}.costSection.gray>header{background:linear-gradient(135deg,#f4f6fa,#e7ecf3)!important;color:#60708b!important}.costSectionTitle{display:flex!important;align-items:center!important;gap:9px!important;min-width:0}.costSectionIcon{display:grid;place-items:center;width:38px;height:38px;min-width:38px;border-radius:13px;background:rgba(255,255,255,.8);box-shadow:0 4px 12px rgba(70,75,115,.12)}.costSectionIcon svg{width:25px;height:25px;fill:currentColor}.costNumberBadge{display:grid;place-items:center;width:27px;height:27px;min-width:27px;border-radius:50%;background:currentColor;color:#fff;font-size:0}.costNumberBadge:after{content:attr(data-no)}.costSectionTitle .costNumberBadge{font-size:19px!important;background:transparent!important;color:currentColor!important;font-weight:1000}.costSectionTitle strong{font-size:20px!important;font-weight:1000!important;white-space:nowrap}.costSectionTitle small{font-size:13px!important;color:#66708a!important}.sectionTotal{padding:6px 8px;border-radius:18px;background:rgba(255,255,255,.55)}.sectionTotal>strong{font-size:23px!important}.sectionTotal button{border:0!important;border-radius:999px!important;background:#fff!important;color:currentColor!important;box-shadow:0 4px 12px rgba(70,70,100,.10)!important}.costHead{background:#f6f6fa!important;color:#5b6480!important}.costRow{background:#fff}.costRow input{margin:3px;padding:7px 8px!important;border:1px solid transparent!important;border-radius:10px!important}.costRow input:focus{outline:none;border-color:#93bdf9!important;background:#f9fcff!important;box-shadow:0 0 0 3px rgba(79,141,247,.12)}.costRow>button{border-radius:50%!important;color:#bd5277!important}.costEmpty{margin:12px;border:2px dashed #eadbe5;border-radius:18px;background:#fffafd;color:#8c7e91!important}.costBottom>section{border:1px solid #eadfea!important;border-radius:24px!important;box-shadow:0 10px 24px rgba(86,69,105,.07)!important}.costBottom h3{padding:7px 10px;border-radius:13px;background:#f7f3f8}.costBottom textarea{border-radius:16px!important;background:#fffafd!important}.profitLine,.marginLine,.costBottom .grand{border-radius:12px;margin-top:5px;border-bottom:0!important}.costBrand img{border-radius:18px!important;box-shadow:0 8px 20px rgba(211,91,145,.18)}
@media(max-width:820px){.costHero{border-radius:20px}.costInfoCard{border-radius:20px}.costKpis article{border-radius:20px;min-height:104px!important}.costKpis article strong,.costKpis article input{font-size:23px!important}.costSection{border-radius:20px!important}.costSection>header{border-radius:18px 18px 0 0}.costSectionTitle{flex-wrap:wrap}.costSectionTitle strong{font-size:18px!important}.costSectionTitle small{width:100%;padding-left:82px;margin-top:-5px}.costSectionIcon{width:35px;height:35px;min-width:35px}.costNumberBadge{font-size:17px!important}.costTable{overflow:visible!important}.costHead{display:none!important}.costRow{display:grid!important;grid-template-columns:42px minmax(0,1fr) minmax(0,1fr)!important;min-width:0!important;margin:10px;padding:10px;border:1px solid #ebe4ed;border-radius:17px;box-shadow:0 5px 15px rgba(80,66,99,.05)}.costRow>*{border:0!important;padding:7px!important;min-width:0}.costRow>span{grid-column:1;grid-row:1/3;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#f1f5fb;color:#65728b}.costRow>input:nth-of-type(1){grid-column:2/-1}.costRow>input:nth-of-type(2){grid-column:2/-1}.costRow>strong{grid-column:2/-1;text-align:right;font-size:18px;color:#d85e8f}.costRow>button{grid-column:3;justify-self:end}.taxIncluded{grid-column:2/-1!important}.costBottom{gap:10px!important}}
@media print{@page{size:A4 landscape;margin:5mm}.costPage{zoom:.54!important;padding:0!important;background:#fff!important;width:100%!important}.costHero{padding:4px 8px!important;margin:0 0 4px!important;border-radius:8px!important;box-shadow:none!important}.costHero h1{font-size:22px!important}.costBrand img{width:38px!important;height:38px!important}.costInfoCard{padding:5px!important;gap:2px 5px!important;border-radius:7px!important;box-shadow:none!important}.costInfoCard span,.costInfoCard input{padding:2px 4px!important;font-size:8px!important}.costKpis{gap:5px!important;margin:5px 0!important}.costKpis article{min-height:58px!important;padding:3px!important;border-radius:8px!important;box-shadow:none!important}.costKpis article span{font-size:8px!important}.costKpis article strong,.costKpis article input{font-size:17px!important}.costKpis article small{font-size:7px!important}.costSection{margin:4px 0!important;border-radius:7px!important;box-shadow:none!important;break-inside:avoid}.costSection>header{min-height:28px!important;padding:3px 6px!important;border-radius:6px 6px 0 0!important}.costSectionIcon{width:22px!important;height:22px!important;min-width:22px!important;border-radius:6px!important}.costSectionIcon svg{width:15px!important;height:15px!important}.costNumberBadge{font-size:12px!important;width:18px!important;min-width:18px!important}.costSectionTitle strong{font-size:11px!important}.costSectionTitle small{font-size:7px!important}.sectionTotal{padding:1px 4px!important}.sectionTotal>strong{font-size:12px!important}.costHead,.costRow{grid-template-columns:34px 1.4fr 1fr 55px 48px 68px 75px 1fr 35px!important;min-width:0!important;font-size:7px!important}.costHead span,.costRow>*{padding:2px!important}.costRow input{margin:0!important;padding:1px!important;font-size:7px!important}.costEmpty{display:none!important}.costBottom{grid-template-columns:1.2fr .9fr .8fr!important;gap:5px!important;margin-top:5px!important}.costBottom>section{padding:5px!important;border-radius:7px!important;box-shadow:none!important}.costBottom h3{margin:0 0 3px!important;padding:2px!important;font-size:9px!important}.costBottom textarea{min-height:45px!important;padding:3px!important;font-size:7px!important}.costBottom section>div{padding:2px!important;font-size:8px!important}.costBottom .grand,.profitLine,.marginLine{font-size:10px!important}.costHeroActions,.sectionTotal button,.costRow>button{display:none!important}body{overflow:visible!important}}

/* M-CROSS_COST_CUTE_V3_SAFE */
.costPage,.costPage input,.costPage button,.costPage textarea{font-family:"BIZ UDPGothic","BIZ UDPゴシック","BIZ UDP Gothic","Yu Gothic UI","Yu Gothic",Meiryo,sans-serif!important}.costPage{font-weight:500!important}.costHero h1,.costKpis span,.costSectionTitle strong,.costBottom h3{font-weight:700!important;letter-spacing:.02em!important}.costKpis article{grid-template-columns:76px 1fr!important;grid-template-rows:auto 1fr auto!important;place-items:stretch!important;padding:14px 16px!important}.kpiArt{grid-column:1;grid-row:1/4;display:grid;place-items:center;align-self:center;width:62px;height:62px;border-radius:20px;background:rgba(255,255,255,.50);box-shadow:inset 0 0 0 1px rgba(255,255,255,.75)}.kpiArt svg{width:48px;height:48px;fill:currentColor;color:inherit}.costKpis article>span{grid-column:2;align-self:end;text-align:left;font-size:15px}.costKpis article>strong,.costKpis article>input{grid-column:2!important;text-align:left!important;font-size:28px!important}.costKpis article>small{grid-column:2;text-align:left;font-weight:600}.costKpis .estimate .kpiArt{color:#ef6598}.costKpis .cost .kpiArt{color:#39ae83}.costKpis .profit .kpiArt{color:#357fe3}.costKpis .margin .kpiArt{color:#e79552}.costSectionIcon{width:48px!important;height:48px!important;min-width:48px!important;border-radius:17px!important}.costSectionIcon svg{width:33px!important;height:33px!important}.costNumberBadge{font-family:"BIZ UDPGothic","BIZ UDPゴシック","Yu Gothic",sans-serif!important}.costRow input{font-weight:500!important}.sectionTotal button{font-weight:700!important}@media(max-width:820px){.costKpis article{grid-template-columns:58px 1fr!important;padding:10px!important}.kpiArt{width:50px;height:50px;border-radius:16px}.kpiArt svg{width:39px;height:39px}.costKpis article>span{font-size:12px}.costKpis article>strong,.costKpis article>input{font-size:21px!important}.costSectionIcon{width:42px!important;height:42px!important;min-width:42px!important}.costSectionIcon svg{width:29px!important;height:29px!important}}@media print{.kpiArt{width:34px!important;height:34px!important;border-radius:8px!important}.kpiArt svg{width:27px!important;height:27px!important}.costKpis article{grid-template-columns:40px 1fr!important;grid-template-rows:auto 1fr!important}.costKpis article>strong,.costKpis article>input{font-size:15px!important}.costKpis article>span{font-size:7px!important}.costSectionIcon{width:24px!important;height:24px!important;min-width:24px!important}.costSectionIcon svg{width:17px!important;height:17px!important}}

/* M-CROSS_COST_READABLE_GRID_V4_SAFE */
/* 原価表は「かわいい」を残しつつ、読みやすさ優先で罫線を明確化 */
.costPage{color:#243252!important}
.costHead{background:#f2f4f9!important;color:#354566!important;font-weight:700!important}
.costHead span{border-right:1px solid #bac5d6!important;border-bottom:1px solid #aebdd1!important;padding:10px 7px!important}
.costRow{background:#fff!important}
.costRow>*{border-right:1px solid #c3ccda!important;border-bottom:1px solid #c3ccda!important;padding:8px!important}
.costRow>span:first-child{border-left:1px solid #c3ccda!important;color:#263552!important;font-weight:700!important}
.costRow input{margin:0!important;width:100%!important;min-height:38px!important;box-sizing:border-box!important;border:1px solid #d4dbe7!important;border-radius:9px!important;background:#fff!important;color:#1f2b47!important;font-weight:600!important;padding:7px 9px!important}
.costRow input::placeholder{color:#8994a7!important}
.costRow input:focus{border-color:#67a2f5!important;background:#fbfdff!important;box-shadow:0 0 0 3px rgba(78,141,235,.13)!important}
.costRow>strong{display:flex!important;align-items:center!important;justify-content:flex-end!important;color:#243252!important;font-size:17px!important;font-weight:800!important;background:#fbfcfe!important}
.costRow>button{display:grid!important;place-items:center!important;margin:auto!important;width:32px!important;height:32px!important;border:1px solid #f2b5c9!important;border-radius:50%!important;background:#fff4f8!important;color:#cf4c7a!important}
.costSection{border:1px solid #c4cedc!important}
.costSection .costTable{border-top:1px solid #b9c5d6!important}
.costSectionTitle strong{color:currentColor!important;text-shadow:none!important}
.costSectionTitle small{color:#5f6d82!important;font-weight:600!important}
.costSection.blue .costRow>span:first-child{background:#f4f8ff!important}
.costSection.pink .costRow>span:first-child{background:#fff5f8!important}
.costSection.green .costRow>span:first-child{background:#f1fbf7!important}
.costSection.purple .costRow>span:first-child{background:#faf5ff!important}
.costSection.gray .costRow>span:first-child{background:#f5f7fa!important}
@media(max-width:820px){
  .costRow{border:1px solid #c7d0dd!important;border-radius:17px!important;overflow:hidden!important}
  .costRow>*{border-right:0!important;border-bottom:1px solid #e0e5ed!important}
  .costRow>span:first-child{border-left:0!important;background:#f4f7fb!important}
  .costRow input{min-height:44px!important;font-size:15px!important}
  .costRow>strong{min-height:42px!important;font-size:18px!important}
}
@media print{
  .costHead span,.costRow>*{border-color:#9da8b6!important}
  .costRow input{min-height:0!important;border:0!important;border-radius:0!important;padding:1px!important;font-size:7px!important;box-shadow:none!important}
  .costRow>strong{font-size:8px!important;background:#fff!important}
}

/* M-CROSS_COST_BIG_NUMBERS_V5_SAFE */
/* KPIと各セクション小計は、参考デザインのように数字を主役にする */
.costKpis article{min-height:138px!important}
.costKpis article>span{font-size:17px!important;font-weight:700!important;line-height:1.2!important}
.costKpis article>strong,.costKpis article>input{font-size:38px!important;line-height:1!important;font-weight:800!important;letter-spacing:.01em!important;font-variant-numeric:tabular-nums!important}
.costKpis article>small{font-size:13px!important;color:#263252!important;font-weight:600!important}
.kpiArt{width:72px!important;height:72px!important;border-radius:22px!important}.kpiArt svg{width:55px!important;height:55px!important}
.sectionTotal>span{font-size:15px!important;font-weight:700!important}.sectionTotal>strong{min-width:120px;text-align:right;font-size:29px!important;line-height:1!important;font-weight:800!important;font-variant-numeric:tabular-nums!important}
.costRow>strong{font-size:19px!important;font-variant-numeric:tabular-nums!important}
@media(max-width:820px){.costKpis article{min-height:116px!important}.costKpis article>span{font-size:13px!important}.costKpis article>strong,.costKpis article>input{font-size:27px!important}.kpiArt{width:56px!important;height:56px!important}.kpiArt svg{width:43px!important;height:43px!important}.sectionTotal>strong{font-size:24px!important;min-width:95px}.costRow>strong{font-size:20px!important}}
@media print{.costKpis article{min-height:55px!important}.costKpis article>strong,.costKpis article>input{font-size:16px!important}.costKpis article>span{font-size:7px!important}.sectionTotal>strong{font-size:12px!important;min-width:0}.costRow>strong{font-size:8px!important}}

/* M-CROSS_COST_CUTE_TYPOGRAPHY_V6_SAFE */
/* Designer参考: 丸く、太く、読みやすい文字へ */
.costPage,.costPage input,.costPage button,.costPage textarea{font-family:"BIZ UDPGothic","BIZ UDP Gothic","BIZ UDPゴシック","Yu Gothic UI","Yu Gothic",Meiryo,Arial,sans-serif!important;font-feature-settings:"palt" 1;font-kerning:normal}
.costHero h1{font-family:"BIZ UDPGothic","BIZ UDP Gothic","Yu Gothic UI","Yu Gothic",Meiryo,sans-serif!important;font-size:38px!important;font-weight:800!important;letter-spacing:.045em!important;color:#24223c!important;line-height:1.15!important;text-shadow:0 2px 0 #fff,0 5px 14px rgba(61,52,90,.08)!important}
.costBrand small{font-size:15px!important;font-weight:700!important;letter-spacing:.04em!important}.costBrand strong{font-size:25px!important;font-weight:800!important;letter-spacing:.015em!important}
.costInfoCard label span{font-size:15px!important;font-weight:800!important;letter-spacing:.02em!important;color:#2d385b!important;background:linear-gradient(180deg,#f1f3f7,#e8ebf1)!important;border:1px solid #e0e4eb!important;border-radius:10px!important}
.costInfoCard input{font-size:15px!important;font-weight:600!important;color:#1f2945!important}
.costKpis article>span{font-size:18px!important;font-weight:800!important;letter-spacing:.01em!important}.costKpis article>strong,.costKpis article>input{font-size:39px!important;font-weight:800!important;letter-spacing:.015em!important}.costKpis article>small{font-size:13px!important;font-weight:600!important;color:#303a57!important}
.costSectionTitle strong{font-size:21px!important;font-weight:800!important;letter-spacing:.015em!important}.costSectionTitle small{font-size:13px!important;font-weight:700!important;color:#69758a!important}.costNumberBadge{font-weight:800!important}
.costHead span{font-size:14px!important;font-weight:800!important;letter-spacing:.01em!important;color:#34415f!important}.costRow input{font-size:15px!important;font-weight:600!important;color:#202b47!important}.costRow>span{font-size:15px!important}.costRow>strong{font-size:20px!important;font-weight:800!important;color:#243252!important}.sectionTotal>span{font-size:15px!important;font-weight:800!important}.sectionTotal>strong{font-size:30px!important;font-weight:800!important;letter-spacing:.01em!important}.sectionTotal button{font-size:14px!important;font-weight:800!important}
.costBottom h3{font-size:17px!important;font-weight:800!important;color:#2c3658!important}.costBottom section>div{font-size:14px!important;font-weight:600!important}.costBottom section>div b{font-size:16px!important;font-weight:800!important}
@media(max-width:820px){.costHero h1{font-size:30px!important}.costInfoCard label span{font-size:13px!important}.costInfoCard input{font-size:15px!important}.costKpis article>span{font-size:13px!important}.costKpis article>strong,.costKpis article>input{font-size:28px!important}.costSectionTitle strong{font-size:19px!important}.costSectionTitle small{font-size:12px!important}.costRow input{font-size:16px!important}.costRow>strong{font-size:21px!important}}
@media print{.costHero h1{font-size:21px!important;text-shadow:none!important}.costInfoCard label span,.costInfoCard input{font-size:7px!important}.costKpis article>span{font-size:7px!important}.costKpis article>strong,.costKpis article>input{font-size:16px!important}.costSectionTitle strong{font-size:10px!important}.costSectionTitle small{font-size:6px!important}.costHead span,.costRow input,.costRow>span{font-size:7px!important}.costRow>strong{font-size:8px!important}.sectionTotal>strong{font-size:12px!important}}

/* M-CROSS_COST_COMPACT_ONE_SCREEN_V7_SAFE */
/* PCは全体を1画面で俯瞰しやすく。数字は4カードで完全統一。 */
@media(min-width:821px){
  .costPage{padding:9px 12px!important;font-size:13px!important}
  .costHero{min-height:54px!important;padding:7px 12px!important;margin-bottom:6px!important;border-radius:18px!important}
  .costHero h1{font-size:29px!important;line-height:1!important}
  .costBrand img{width:42px!important;height:42px!important;border-radius:13px!important}
  .costBrand small{font-size:11px!important}.costBrand strong{font-size:19px!important}
  .costHeroActions button{min-height:34px!important;padding:5px 10px!important;font-size:12px!important}
  .costInfoCard{padding:7px 10px!important;gap:3px 8px!important;border-radius:17px!important}
  .costInfoCard label span{padding:4px 7px!important;font-size:12px!important;border-radius:8px!important}
  .costInfoCard input{min-height:27px!important;padding:3px 7px!important;font-size:13px!important}
  .costKpis{gap:9px!important;margin:7px 0!important}
  .costKpis article{min-height:88px!important;padding:7px 10px!important;border-radius:19px!important;grid-template-columns:52px 1fr!important}
  .kpiArt{width:46px!important;height:46px!important;border-radius:15px!important}.kpiArt svg{width:35px!important;height:35px!important}
  .costKpis article>span{font-size:13px!important;line-height:1.05!important}
  .costKpis article>strong,.costKpis article>input,.costKpis .estimate input{font-size:30px!important;line-height:1!important;font-weight:800!important;height:auto!important;min-height:0!important;padding:0!important;margin:0!important;color:inherit!important}
  .costKpis article>small{font-size:10px!important;line-height:1!important}
  .costSection{margin:6px 0!important;border-radius:16px!important}
  .costSection>header{min-height:40px!important;padding:4px 8px!important;border-radius:15px 15px 0 0!important}
  .costSectionTitle{gap:6px!important}.costSectionIcon{width:32px!important;height:32px!important;min-width:32px!important;border-radius:11px!important}.costSectionIcon svg{width:22px!important;height:22px!important}
  .costNumberBadge{width:21px!important;min-width:21px!important;height:21px!important;font-size:14px!important}
  .costSectionTitle strong{font-size:15px!important}.costSectionTitle small{font-size:10px!important}
  .sectionTotal{gap:7px!important;padding:2px 5px!important;border-radius:13px!important}.sectionTotal>span{font-size:11px!important}.sectionTotal>strong{min-width:82px!important;font-size:20px!important}.sectionTotal button{min-height:30px!important;padding:3px 9px!important;font-size:11px!important}
  .costHead,.costRow{grid-template-columns:42px minmax(140px,1.3fr) minmax(120px,1fr) 65px 56px 88px 96px minmax(120px,1fr) 44px!important}
  .costHead span{padding:4px!important;font-size:11px!important}
  .costRow>*{padding:3px 5px!important}
  .costRow input{min-height:25px!important;padding:2px 5px!important;font-size:12px!important;border-radius:6px!important}
  .costRow>span{font-size:12px!important}.costRow>strong{font-size:14px!important}.costRow>button{width:24px!important;height:24px!important;font-size:11px!important}
  .costEmpty{padding:7px!important;margin:5px!important;font-size:11px!important}
  .costBottom{gap:7px!important;margin-top:6px!important}.costBottom>section{padding:7px!important;border-radius:16px!important}.costBottom h3{margin:0 0 5px!important;padding:4px 7px!important;font-size:13px!important}.costBottom textarea{min-height:72px!important;padding:6px!important;font-size:11px!important}.costBottom section>div{padding:3px 5px!important;font-size:11px!important}.costBottom section>div b{font-size:12px!important}.costBottom .grand,.profitLine,.marginLine{font-size:13px!important}
}
/* 見積金額だけ小さくならないよう4カードの数値を明示的に同サイズ化 */
.costKpis .estimate input,.costKpis .cost strong,.costKpis .profit strong,.costKpis .margin strong{font-variant-numeric:tabular-nums!important;font-weight:800!important}
@media(max-width:820px){
 .costKpis .estimate input,.costKpis .cost strong,.costKpis .profit strong,.costKpis .margin strong{font-size:27px!important}
}
@media print{
 .costKpis .estimate input,.costKpis .cost strong,.costKpis .profit strong,.costKpis .margin strong{font-size:16px!important}
}

/* M-CROSS_COST_TAX_INCLUDED_COLUMN_V8_SAFE */
.taxIncludedCell{display:flex!important;align-items:center!important;justify-content:flex-end!important;min-width:0;background:#fffaf4!important;border-right:1px solid #c3ccda!important;border-bottom:1px solid #c3ccda!important}.taxIncludedCell>strong{width:100%;text-align:right;color:#a75e2c;font-size:18px;font-weight:800;font-variant-numeric:tabular-nums}.taxIncludedCell>input{width:100%!important;min-height:38px!important;box-sizing:border-box!important;border:1px solid #ead8c9!important;border-radius:9px!important;background:#fff!important;color:#8b4b22!important;text-align:right;font-weight:700!important}.costHead span:nth-child(8){background:#fff5ea!important;color:#8b4b22!important}@media(min-width:821px){.taxIncludedCell>strong{font-size:14px}.taxIncludedCell>input{min-height:25px!important;font-size:12px!important;padding:2px 5px!important;border-radius:6px!important}}@media(max-width:820px){.taxIncludedCell{grid-column:2/-1!important;min-height:44px!important;border-right:0!important}.taxIncludedCell:before{content:'税込金額';margin-right:auto;color:#8b6d57;font-size:12px;font-weight:800}.taxIncludedCell>strong{width:auto;font-size:19px}.taxIncludedCell>input{width:min(190px,65%)!important;font-size:16px!important}}@media print{.taxIncludedCell{background:#fff!important}.taxIncludedCell>strong{font-size:8px!important;color:#222!important}.taxIncludedCell>input{min-height:0!important;border:0!important;border-radius:0!important;padding:1px!important;font-size:7px!important}}

/* M-CROSS_COST_ESTIMATE_AMOUNT_ONLY_V7A_SAFE */
/* 見積金額だけ他のKPI数値と同じ大きさ・太さに固定 */
.costKpis .estimate input[type="number"]{font-size:30px!important;font-weight:800!important;line-height:1!important;letter-spacing:.01em!important;color:#bd2c5a!important;width:100%!important;min-width:0!important;height:auto!important;min-height:0!important;padding:0!important;margin:0!important;text-align:left!important;background:transparent!important;border:0!important;box-shadow:none!important;font-variant-numeric:tabular-nums!important}
@media(max-width:820px){.costKpis .estimate input[type="number"]{font-size:27px!important}}
@media print{.costKpis .estimate input[type="number"]{font-size:16px!important;color:#000!important}}

/* M-CROSS_COST_ROWS_ONEPAGE_PRINT_V10_SAFE */
/* 画面は行数を増やしても見渡しやすく、印刷は使用行だけでA4横1枚に集約 */
.costPrintOnly{display:none}
@media(min-width:821px){
 .costPage{max-width:1500px;margin:0 auto;padding:6px 10px!important}
 .costHero{min-height:46px!important;padding:5px 10px!important;margin-bottom:4px!important}
 .costHero h1{font-size:26px!important}
 .costInfoCard{padding:5px 8px!important;gap:2px 7px!important}
 .costInfoCard label span{padding:3px 6px!important;font-size:11px!important}
 .costInfoCard input{min-height:23px!important;font-size:12px!important}
 .costKpis{margin:5px 0!important;gap:7px!important}
 .costKpis article{min-height:76px!important;padding:5px 8px!important;grid-template-columns:45px 1fr!important;border-radius:17px!important}
 .kpiArt{width:40px!important;height:40px!important;border-radius:13px!important}.kpiArt svg{width:31px!important;height:31px!important}
 .costKpis article>span{font-size:12px!important}.costKpis article>strong,.costKpis article>input,.estimateYen{font-size:26px!important}.costKpis article>small{font-size:9px!important}
 .costSection{margin:4px 0!important}.costSection>header{min-height:34px!important;padding:3px 7px!important}
 .costSectionIcon{width:27px!important;height:27px!important;min-width:27px!important}.costSectionIcon svg{width:19px!important;height:19px!important}
 .costSectionTitle strong{font-size:14px!important}.costSectionTitle small{font-size:9px!important}
 .sectionTotal>strong{font-size:18px!important}.sectionTotal button{min-height:27px!important;font-size:10px!important;padding:2px 8px!important}
 .costHead span{padding:3px!important;font-size:10px!important}.costRow>*{padding:2px 4px!important}.costRow input{min-height:22px!important;font-size:11px!important}.costRow>strong,.taxIncludedCell>strong{font-size:13px!important}.costRow>button{width:22px!important;height:22px!important}
 .costBottom{margin-top:4px!important}.costBottom textarea{min-height:55px!important}
}
@media print{
 @page{size:A4 landscape;margin:4mm}
 html,body,#root{width:100%!important;height:auto!important;margin:0!important;padding:0!important;background:#fff!important}
 .costPage{zoom:1!important;transform:none!important;width:100%!important;max-width:none!important;padding:0!important;color:#111!important;background:#fff!important}
 .costHero{min-height:0!important;padding:2mm 3mm!important;margin:0 0 1.5mm!important;border:1px solid #bbb!important;border-radius:3mm!important;box-shadow:none!important}
 .costHero h1{font-size:16pt!important}.costBrand img{width:9mm!important;height:9mm!important}.costBrand small{font-size:6pt!important}.costBrand strong{font-size:10pt!important}
 .costInfoCard{padding:1.5mm 2mm!important;gap:.7mm 2mm!important;border-radius:2mm!important;box-shadow:none!important}.costInfoCard label span,.costInfoCard input{min-height:0!important;padding:.4mm 1mm!important;font-size:6.2pt!important}
 .costKpis{gap:2mm!important;margin:1.5mm 0!important}.costKpis article{min-height:15mm!important;padding:1mm 2mm!important;border-radius:3mm!important;grid-template-columns:9mm 1fr!important}.kpiArt{width:8mm!important;height:8mm!important;border-radius:2mm!important}.kpiArt svg{width:6mm!important;height:6mm!important}.costKpis article>span{font-size:6pt!important}.costKpis article>strong,.costKpis article>input,.estimateYen{font-size:14pt!important}.costKpis article>small{font-size:5.5pt!important}
 .costSection,.costBottom{display:none!important}
 .costPrintOnly{display:block!important}
 .costPrintGroups{display:grid!important;grid-template-columns:1fr 1fr!important;gap:1.5mm!important}
 .costPrintGroups article{border:1px solid #9ca8ba;border-radius:2mm;overflow:hidden;break-inside:avoid}
 .costPrintGroups article:nth-child(3){grid-column:1/-1}
 .costPrintGroups article>header{display:grid;grid-template-columns:7mm 1fr auto;align-items:center;gap:1mm;padding:1mm 1.5mm;background:#eef3fb;border-bottom:1px solid #aeb8c8}
 .costPrintGroups article>header span{display:grid;place-items:center;width:6mm;height:6mm;border-radius:1.5mm;background:#fff}.costPrintGroups article>header svg{width:4.5mm;height:4.5mm;fill:#4d79c7}.costPrintGroups article>header b{font-size:7pt}.costPrintGroups article>header strong{font-size:8pt}
 .costPrintGroups article>div{display:grid;grid-template-columns:5mm minmax(25mm,1.5fr) minmax(18mm,1fr) 16mm 18mm 21mm;gap:1mm;align-items:center;padding:.55mm 1mm;border-bottom:.2mm solid #d6dce5;font-size:5.4pt}.costPrintGroups article>div:last-child{border-bottom:0}.costPrintGroups article>div em{text-align:center;font-style:normal}.costPrintGroups article>div span:nth-of-type(3),.costPrintGroups article>div span:nth-of-type(4),.costPrintGroups article>div b{text-align:right}.costPrintGroups article>small{display:block;padding:1mm;text-align:center;color:#777;font-size:5.5pt}
 .costPrintGroups article:nth-child(3)>div{grid-template-columns:5mm minmax(38mm,1.5fr) minmax(25mm,1fr) 18mm 20mm 23mm}
 .costPrintOnly:after{content:'見積金額  ' attr(data-estimate);display:none}
}

/* M-CROSS_COST_PORTRAIT_COMPACT_V11_SAFE */
/* PC画面も提出印刷も縦長1枚を基準にした高密度レイアウト */
@media(min-width:821px){
 .costPage{max-width:1180px!important;margin:0 auto!important;padding:5px 8px!important;font-size:12px!important}
 .costHero{min-height:40px!important;padding:4px 8px!important;margin-bottom:3px!important;border-radius:14px!important}
 .costHero h1{font-size:24px!important}.costBrand img{width:36px!important;height:36px!important}.costBrand small{font-size:9px!important}.costBrand strong{font-size:16px!important}.costHeroActions button{min-height:29px!important;padding:3px 8px!important;font-size:10px!important}
 .costInfoCard{padding:4px 6px!important;gap:1px 5px!important;border-radius:13px!important}.costInfoCard label span{padding:2px 5px!important;font-size:10px!important}.costInfoCard input{min-height:20px!important;padding:2px 5px!important;font-size:11px!important}
 .costKpis{gap:5px!important;margin:4px 0!important}.costKpis article{min-height:63px!important;padding:4px 6px!important;border-radius:14px!important;grid-template-columns:37px 1fr!important}.kpiArt{width:34px!important;height:34px!important;border-radius:11px!important}.kpiArt svg{width:26px!important;height:26px!important}.costKpis article>span{font-size:10px!important}.costKpis article>strong,.costKpis article>input,.estimateYen{font-size:22px!important}.costKpis article>small{font-size:8px!important}
 .costSection{margin:3px 0!important;border-radius:12px!important}.costSection>header{min-height:28px!important;padding:2px 5px!important;border-radius:11px 11px 0 0!important}.costSectionIcon{width:23px!important;height:23px!important;min-width:23px!important;border-radius:8px!important}.costSectionIcon svg{width:16px!important;height:16px!important}.costNumberBadge{width:17px!important;min-width:17px!important;height:17px!important;font-size:11px!important}.costSectionTitle{gap:4px!important}.costSectionTitle strong{font-size:12px!important}.costSectionTitle small{font-size:8px!important}.sectionTotal{gap:4px!important;padding:1px 4px!important}.sectionTotal>span{font-size:9px!important}.sectionTotal>strong{min-width:64px!important;font-size:16px!important}.sectionTotal button{min-height:23px!important;padding:1px 6px!important;font-size:9px!important}
 .costHead,.costRow{grid-template-columns:34px minmax(120px,1.35fr) minmax(100px,1fr) 52px 45px 72px 78px 88px 35px!important}.costHead span{padding:2px 3px!important;font-size:9px!important}.costRow>*{padding:1px 3px!important}.costRow input{min-height:18px!important;padding:1px 4px!important;font-size:10px!important;border-radius:5px!important}.costRow>span{font-size:10px!important}.costRow>strong,.taxIncludedCell>strong{font-size:11px!important}.taxIncludedCell>input{min-height:18px!important;font-size:10px!important}.costRow>button{width:19px!important;height:19px!important;font-size:9px!important}
 .costBottom{gap:5px!important;margin-top:3px!important}.costBottom>section{padding:5px!important;border-radius:12px!important}.costBottom h3{margin:0 0 3px!important;padding:2px 4px!important;font-size:11px!important}.costBottom textarea{min-height:42px!important;padding:4px!important;font-size:9px!important}.costBottom section>div{padding:2px 3px!important;font-size:9px!important}.costBottom section>div b{font-size:10px!important}
}
@media print{
 @page{size:A4 portrait;margin:3.5mm}
 html,body,#root{width:100%!important;height:auto!important;margin:0!important;padding:0!important;background:#fff!important}
 .costPage{zoom:1!important;transform:none!important;width:100%!important;max-width:none!important;padding:0!important;background:#fff!important;color:#111!important}
 .costHero{min-height:0!important;padding:1mm 2mm!important;margin:0 0 1mm!important;border-radius:2mm!important;box-shadow:none!important}.costHero h1{font-size:13pt!important}.costBrand img{width:7mm!important;height:7mm!important}.costBrand small{font-size:5pt!important}.costBrand strong{font-size:8pt!important}
 .costInfoCard{padding:1mm 1.5mm!important;gap:.4mm 1.5mm!important;border-radius:1.5mm!important;box-shadow:none!important}.costInfoCard label span,.costInfoCard input{min-height:0!important;padding:.25mm .8mm!important;font-size:5.4pt!important}
 .costKpis{gap:1mm!important;margin:1mm 0!important}.costKpis article{min-height:11mm!important;padding:.7mm 1mm!important;border-radius:2mm!important;grid-template-columns:7mm 1fr!important}.kpiArt{width:6mm!important;height:6mm!important;border-radius:1.5mm!important}.kpiArt svg{width:4.6mm!important;height:4.6mm!important}.costKpis article>span{font-size:5.2pt!important}.costKpis article>strong,.costKpis article>input,.estimateYen{font-size:11pt!important}.costKpis article>small{font-size:4.5pt!important}
 .costSection,.costBottom{display:block!important;margin:.8mm 0!important;border-radius:1.5mm!important;box-shadow:none!important;break-inside:avoid}.costSection>header{min-height:0!important;padding:.45mm 1mm!important;border-radius:1.2mm 1.2mm 0 0!important}.costSectionIcon{width:5mm!important;height:5mm!important;min-width:5mm!important;border-radius:1mm!important}.costSectionIcon svg{width:3.6mm!important;height:3.6mm!important}.costNumberBadge{width:4mm!important;min-width:4mm!important;height:4mm!important;font-size:7pt!important}.costSectionTitle strong{font-size:6.4pt!important}.costSectionTitle small{font-size:4.4pt!important}.sectionTotal{padding:0!important;gap:1mm!important}.sectionTotal>span{font-size:4.5pt!important}.sectionTotal>strong{min-width:14mm!important;font-size:7pt!important}.sectionTotal button{display:none!important}
 .costTable{overflow:visible!important}.costHead,.costRow{display:grid!important;grid-template-columns:6mm minmax(28mm,1.35fr) minmax(22mm,1fr) 12mm 10mm 16mm 18mm 20mm 7mm!important;min-width:0!important}.costHead span{padding:.3mm!important;font-size:4.5pt!important;border-color:#9faaba!important}.costRow>*{padding:.2mm .45mm!important;border-color:#aeb7c5!important}.costRow input,.taxIncludedCell>input{min-height:0!important;border:0!important;border-radius:0!important;padding:0!important;font-size:4.6pt!important;box-shadow:none!important}.costRow>span{font-size:4.6pt!important}.costRow>strong,.taxIncludedCell>strong{font-size:5pt!important;background:#fff!important;color:#111!important}.costRow>button{display:none!important}
 .costEmpty{display:none!important}.costPrintOnly{display:none!important}
 .costBottom{display:grid!important;grid-template-columns:1.1fr .95fr .8fr!important;gap:1mm!important;margin-top:1mm!important}.costBottom>section{padding:1mm!important;border-radius:1.5mm!important;box-shadow:none!important}.costBottom h3{margin:0 0 .4mm!important;padding:.3mm!important;font-size:5.5pt!important}.costBottom textarea{min-height:14mm!important;padding:.5mm!important;font-size:4.5pt!important;border-radius:1mm!important}.costBottom section>div{padding:.3mm .6mm!important;font-size:4.5pt!important}.costBottom section>div b{font-size:5pt!important}.costHeroActions{display:none!important}
}

/* M-CROSS_COST_HEADER_PORTRAIT_V12_SAFE */
.costInfoCompact{grid-template-columns:84px minmax(0,1.45fr) 84px minmax(0,1fr)!important;gap:4px 8px!important;padding:5px 7px!important}.costInfoCompact label{display:contents!important}.costPropertyCombined>div{display:grid!important;grid-template-columns:minmax(0,1fr) 86px!important;gap:5px!important}.costPropertyCombined .propertyUnit{text-align:center!important}.costInfoCompact label>span{display:flex;align-items:center;justify-content:center}.costPrintOnly{display:none!important}
@media(max-width:820px){.costInfoCompact{grid-template-columns:72px minmax(0,1fr)!important}.costPropertyCombined>div{grid-template-columns:minmax(0,1fr) 72px!important}.costInfoCompact input{min-width:0!important}}
@media print{
 @page{size:A4 portrait;margin:3mm}
 .costPrintOnly{display:none!important}
 .costSection,.costBottom{display:block!important}
 .costInfoCompact{display:grid!important;grid-template-columns:18mm minmax(0,1.45fr) 18mm minmax(0,1fr)!important;gap:.5mm 1.2mm!important;padding:.8mm 1mm!important}.costInfoCompact label{display:contents!important}.costPropertyCombined>div{display:grid!important;grid-template-columns:minmax(0,1fr) 17mm!important;gap:1mm!important}.costInfoCompact label>span,.costInfoCompact input{font-size:5.2pt!important;min-height:5mm!important;padding:.2mm .7mm!important}
}

/* M-CROSS_COST_TIGHT_ROWS_V13_SAFE */
/* 文字サイズは保ち、枠・行高・余白だけを徹底的に圧縮 */
@media(min-width:821px){
 .costHead{min-height:20px!important}
 .costHead span{display:flex!important;align-items:center!important;justify-content:center!important;height:20px!important;box-sizing:border-box!important;padding:1px 3px!important;font-size:9.5px!important;line-height:1!important}
 .costRow{min-height:23px!important;height:23px!important}
 .costRow>*{height:23px!important;min-height:23px!important;box-sizing:border-box!important;padding:1px 3px!important;line-height:1!important}
 .costRow input{height:20px!important;min-height:20px!important;margin:1px 0!important;padding:0 4px!important;border-radius:4px!important;font-size:10.5px!important;line-height:18px!important}
 .costRow>span{font-size:10px!important;line-height:21px!important}
 .costRow>strong,.taxIncludedCell>strong{font-size:11.5px!important;line-height:21px!important}
 .taxIncludedCell{height:23px!important;min-height:23px!important;padding:1px 3px!important}
 .taxIncludedCell>input{height:20px!important;min-height:20px!important;margin:0!important;padding:0 4px!important;font-size:10.5px!important;line-height:18px!important}
 .costRow>button{width:18px!important;height:18px!important;min-height:18px!important;margin:2px auto!important;padding:0!important;font-size:8px!important}
 .costSection>header{min-height:25px!important;padding:1px 5px!important}
 .costSectionIcon{width:20px!important;height:20px!important;min-width:20px!important;border-radius:7px!important}.costSectionIcon svg{width:14px!important;height:14px!important}
 .costNumberBadge{width:15px!important;min-width:15px!important;height:15px!important;font-size:10px!important}
 .costSectionTitle strong{font-size:11.5px!important;line-height:1!important}.costSectionTitle small{font-size:7.5px!important;line-height:1!important}
 .sectionTotal{min-height:22px!important;padding:0 3px!important}.sectionTotal>span{font-size:8.5px!important}.sectionTotal>strong{font-size:15px!important}.sectionTotal button{min-height:20px!important;height:20px!important;padding:0 6px!important;font-size:8px!important;line-height:18px!important}
 .costSection{margin:2px 0!important}
}
@media print{
 @page{size:A4 portrait;margin:2.5mm}
 .costHead{min-height:3.6mm!important;height:3.6mm!important}.costHead span{height:3.6mm!important;padding:.15mm .35mm!important;font-size:4.7pt!important;line-height:1!important}
 .costRow{min-height:4.1mm!important;height:4.1mm!important}.costRow>*{height:4.1mm!important;min-height:4.1mm!important;padding:.1mm .35mm!important;line-height:1!important}
 .costRow input,.taxIncludedCell>input{height:3.5mm!important;min-height:3.5mm!important;margin:.15mm 0!important;padding:0 .35mm!important;font-size:4.7pt!important;line-height:3.2mm!important}
 .costRow>span{font-size:4.7pt!important;line-height:3.8mm!important}.costRow>strong,.taxIncludedCell>strong{font-size:5pt!important;line-height:3.8mm!important}
 .taxIncludedCell{height:4.1mm!important;min-height:4.1mm!important;padding:.1mm .35mm!important}
 .costSection>header{min-height:4.6mm!important;height:4.6mm!important;padding:.2mm .8mm!important}.costSectionIcon{width:4mm!important;height:4mm!important;min-width:4mm!important}.costSectionIcon svg{width:2.8mm!important;height:2.8mm!important}.costNumberBadge{width:3.4mm!important;min-width:3.4mm!important;height:3.4mm!important;font-size:5.5pt!important}.costSectionTitle strong{font-size:6pt!important}.costSectionTitle small{font-size:4.1pt!important}.sectionTotal{min-height:4mm!important;height:4mm!important}.sectionTotal>strong{font-size:6.5pt!important}
 .costSection{margin:.45mm 0!important}
}

/* M-CROSS_COST_TRUE_ONEPAGE_PRINT_V14_SAFE */
/* 旧原価計算書の密度を参考に、画面そのものをA4縦1枚へ収める印刷専用圧縮 */
@media print{
 @page{size:A4 portrait;margin:2mm}
 html,body,#root{width:210mm!important;min-width:210mm!important;height:auto!important;margin:0!important;padding:0!important;background:#fff!important;overflow:visible!important}
 body{zoom:1!important}
 .costPage{width:206mm!important;max-width:206mm!important;margin:0 auto!important;padding:0!important;background:#fff!important;color:#000!important;font-family:"BIZ UDPGothic","BIZ UDP Gothic","Yu Gothic",Meiryo,sans-serif!important}
 .costHero{height:9mm!important;min-height:9mm!important;padding:.5mm 1.5mm!important;margin:0 0 .7mm!important;border:1px solid #8f9aaa!important;border-radius:1.2mm!important;box-shadow:none!important}.costHero h1{font-size:11pt!important;line-height:1!important}.costBrand img{width:6.5mm!important;height:6.5mm!important}.costBrand small{font-size:4.3pt!important}.costBrand strong{font-size:7pt!important}.costHeroActions{display:none!important}
 .costInfoCompact{height:12mm!important;box-sizing:border-box!important;grid-template-columns:13mm 1.45fr 15mm .9fr!important;gap:.3mm 1mm!important;padding:.5mm 1mm!important;margin:0 0 .7mm!important;border-radius:1mm!important;box-shadow:none!important}.costInfoCompact label>span,.costInfoCompact input{height:5mm!important;min-height:5mm!important;padding:.1mm .6mm!important;font-size:4.6pt!important;line-height:4.5mm!important}.costPropertyCombined>div{grid-template-columns:minmax(0,1fr) 16mm!important;gap:.7mm!important}
 .costKpis{height:15mm!important;gap:1mm!important;margin:0 0 .7mm!important}.costKpis article{height:15mm!important;min-height:15mm!important;padding:.7mm 1mm!important;border-radius:1.5mm!important;grid-template-columns:8mm 1fr!important;grid-template-rows:auto 1fr auto!important;box-shadow:none!important}.kpiArt{width:7mm!important;height:7mm!important;border-radius:1.5mm!important}.kpiArt svg{width:5.3mm!important;height:5.3mm!important}.costKpis article>span{font-size:4.6pt!important;line-height:1!important}.costKpis article>strong,.costKpis article>input,.estimateYen{font-size:10pt!important;line-height:1!important}.costKpis article>small{font-size:4pt!important;line-height:1!important}
 .costSection{display:block!important;margin:0 0 .55mm!important;border:1px solid #8f9aaa!important;border-radius:.8mm!important;box-shadow:none!important;overflow:hidden!important;break-inside:avoid!important}.costSection>header{height:5mm!important;min-height:5mm!important;padding:.2mm .8mm!important;border-radius:.7mm .7mm 0 0!important}.costSectionIcon{width:4mm!important;height:4mm!important;min-width:4mm!important;border-radius:.8mm!important}.costSectionIcon svg{width:2.8mm!important;height:2.8mm!important}.costNumberBadge{width:3.4mm!important;min-width:3.4mm!important;height:3.4mm!important;font-size:5.2pt!important}.costSectionTitle{gap:.7mm!important}.costSectionTitle strong{font-size:5.5pt!important;line-height:1!important}.costSectionTitle small{font-size:3.7pt!important;line-height:1!important}.sectionTotal{height:4mm!important;min-height:4mm!important;gap:.7mm!important;padding:0!important}.sectionTotal>span{font-size:3.8pt!important}.sectionTotal>strong{min-width:13mm!important;font-size:6.3pt!important}.sectionTotal button{display:none!important}
 .costTable{overflow:visible!important}.costHead,.costRow{display:grid!important;grid-template-columns:5.5mm minmax(28mm,1.35fr) minmax(22mm,1fr) 10mm 9mm 15mm 17mm 20mm 6mm!important;min-width:0!important}.costHead{height:3.7mm!important;min-height:3.7mm!important}.costHead span{height:3.7mm!important;min-height:3.7mm!important;padding:.1mm .3mm!important;font-size:4.1pt!important;line-height:3.4mm!important;border-color:#8794a6!important}.costRow{height:4.2mm!important;min-height:4.2mm!important}.costRow>*{height:4.2mm!important;min-height:4.2mm!important;padding:.1mm .35mm!important;border-color:#9ca7b6!important;box-sizing:border-box!important}.costRow input,.taxIncludedCell>input{height:3.7mm!important;min-height:3.7mm!important;margin:.15mm 0!important;padding:0 .3mm!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:#fff!important;font-size:4.25pt!important;line-height:3.5mm!important}.costRow>span{font-size:4.25pt!important;line-height:3.9mm!important}.costRow>strong,.taxIncludedCell>strong{font-size:4.5pt!important;line-height:3.9mm!important;background:#fff!important;color:#000!important}.taxIncludedCell{height:4.2mm!important;min-height:4.2mm!important;padding:.1mm .35mm!important;background:#fff!important}.costRow>button{display:none!important}
 .costEmpty,.costPrintOnly{display:none!important}
 .costBottom{display:grid!important;grid-template-columns:1.12fr .95fr .82fr!important;gap:.8mm!important;margin-top:.5mm!important;break-inside:avoid!important}.costBottom>section{padding:.6mm!important;border:1px solid #9ca7b6!important;border-radius:.8mm!important;box-shadow:none!important}.costBottom h3{margin:0 0 .2mm!important;padding:.2mm!important;font-size:4.8pt!important}.costBottom textarea{height:10mm!important;min-height:10mm!important;padding:.3mm!important;border-radius:.5mm!important;font-size:4pt!important}.costBottom section>div{padding:.15mm .4mm!important;font-size:4pt!important;line-height:1.1!important}.costBottom section>div b{font-size:4.4pt!important}.costBottom .grand,.profitLine,.marginLine{font-size:4.6pt!important;margin-top:.2mm!important}
}

/* M-CROSS_COST_PRINT_HORIZONTAL_V16_SAFE */
/* 印刷ではスマホ用2列化を絶対に継承しない。横に置けるものは横1列で縦寸法を節約。 */
@media print{
  .costPage{zoom:.72!important;width:138.89%!important;max-width:none!important}
  .costHero{display:grid!important;grid-template-columns:1fr auto 1fr!important}
  .costInfoCompact{display:grid!important;grid-template-columns:15mm minmax(0,1.35fr) 18mm minmax(0,1fr)!important}
  .costKpis{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;grid-auto-flow:column!important;width:100%!important;height:11mm!important}
  .costKpis article{grid-column:auto!important;grid-row:1!important;width:auto!important;min-width:0!important;height:11mm!important;min-height:11mm!important;grid-template-columns:6mm minmax(0,1fr)!important}
  .costKpis article>span,.costKpis article>strong,.costKpis article>input,.costKpis article>small,.costKpis .estimate .estimateAmountEditor{grid-column:2!important}
  .kpiArt{grid-column:1!important;grid-row:1/4!important;width:5mm!important;height:5mm!important}.kpiArt svg{width:3.8mm!important;height:3.8mm!important}
  .costKpis article>span{font-size:3.9pt!important}.costKpis article>strong,.costKpis article>input,.estimateYen,.costKpis .estimate .estimateAmountEditor input[type="number"]{font-size:8.2pt!important}.costKpis article>small{font-size:3.3pt!important}
  .costSectionTitle{display:flex!important;flex-wrap:nowrap!important}.costSectionTitle small{width:auto!important;padding-left:0!important;margin-top:0!important}
  .sectionTotal{display:flex!important;grid-template-columns:none!important;white-space:nowrap!important}.sectionTotal button{display:none!important}
  .costRow{display:grid!important;margin:0!important;border-radius:0!important;box-shadow:none!important}
  .taxIncludedCell{grid-column:auto!important;min-height:0!important}.taxIncludedCell:before{display:none!important}
  .costBottom{display:grid!important;grid-template-columns:1.1fr .95fr .8fr!important}
}

/* M-CROSS_COST_AUTO_PRINT_DENSITY_V17_SAFE */
/* A4縦の実用的な自動密度。基本29行は紙面を8〜9割使い、増えた時だけ段階的に詰める。 */
@media print{
 @page{size:A4 portrait;margin:3mm}
 html,body,#root{width:100%!important;min-width:0!important;height:auto!important;margin:0!important;padding:0!important;background:#fff!important;overflow:visible!important}
 .costPage{max-width:none!important;margin:0!important;padding:0!important;background:#fff!important;transform-origin:top left!important;color:#000!important}
 .costPage.printComfort{zoom:.94!important;width:106.38%!important}
 .costPage.printCompact{zoom:.86!important;width:116.28%!important}
 .costPage.printDense{zoom:.78!important;width:128.21%!important}
 .costHero{height:auto!important;min-height:8.5mm!important;padding:.6mm 1.5mm!important;margin:0 0 .7mm!important;border-radius:1.5mm!important;box-shadow:none!important}.costHero h1{font-size:12pt!important}.costBrand img{width:6.5mm!important;height:6.5mm!important}.costBrand small{font-size:4.5pt!important}.costBrand strong{font-size:7.5pt!important}.costHeroActions{display:none!important}
 .costInfoCompact{height:auto!important;min-height:11mm!important;padding:.7mm 1.2mm!important;gap:.4mm 1.2mm!important;margin-bottom:.7mm!important;box-shadow:none!important}.costInfoCompact label>span,.costInfoCompact input{height:4.6mm!important;min-height:4.6mm!important;padding:.2mm .7mm!important;font-size:4.8pt!important;line-height:4.2mm!important}
 .costKpis{height:auto!important;min-height:14mm!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:1mm!important;margin:0 0 .7mm!important}.costKpis article{height:14mm!important;min-height:14mm!important;padding:.7mm 1mm!important;border-radius:2mm!important;grid-template-columns:7.5mm 1fr!important}.kpiArt{width:6.5mm!important;height:6.5mm!important}.kpiArt svg{width:5mm!important;height:5mm!important}.costKpis article>span{font-size:4.8pt!important}.costKpis article>strong,.costKpis article>input,.estimateYen,.costKpis .estimate .estimateAmountEditor input[type="number"]{font-size:10.5pt!important}.costKpis article>small{font-size:4pt!important}
 .costSection{display:block!important;margin:0 0 .65mm!important;border-radius:1mm!important;box-shadow:none!important;break-inside:auto!important;page-break-inside:auto!important}.costSection>header{height:4.8mm!important;min-height:4.8mm!important;padding:.2mm .8mm!important}.costSectionIcon{width:4mm!important;height:4mm!important;min-width:4mm!important}.costSectionIcon svg{width:2.9mm!important;height:2.9mm!important}.costNumberBadge{width:3.5mm!important;min-width:3.5mm!important;height:3.5mm!important;font-size:5.5pt!important}.costSectionTitle strong{font-size:6pt!important}.costSectionTitle small{font-size:4pt!important}.sectionTotal{height:4mm!important;min-height:4mm!important;gap:.8mm!important;padding:0 .5mm!important}.sectionTotal>span{font-size:4pt!important}.sectionTotal>strong{min-width:13mm!important;font-size:6.6pt!important}.sectionTotal button{display:none!important}
 .costTable{overflow:visible!important}.costHead,.costRow{display:grid!important;grid-template-columns:5.5mm minmax(28mm,1.35fr) minmax(22mm,1fr) 10mm 9mm 15mm 17mm 20mm 6mm!important;min-width:0!important}.costHead{height:3.8mm!important;min-height:3.8mm!important}.costHead span{height:3.8mm!important;min-height:3.8mm!important;padding:.1mm .3mm!important;font-size:4.4pt!important;line-height:3.6mm!important}.costRow{height:4.35mm!important;min-height:4.35mm!important}.costRow>*{height:4.35mm!important;min-height:4.35mm!important;padding:.1mm .35mm!important;box-sizing:border-box!important}.costRow input,.taxIncludedCell>input{height:3.8mm!important;min-height:3.8mm!important;margin:.15mm 0!important;padding:0 .3mm!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:#fff!important;font-size:4.5pt!important;line-height:3.5mm!important}.costRow>span{font-size:4.5pt!important;line-height:4mm!important}.costRow>strong,.taxIncludedCell>strong{font-size:4.8pt!important;line-height:4mm!important;background:#fff!important;color:#000!important}.taxIncludedCell{height:4.35mm!important;min-height:4.35mm!important;padding:.1mm .35mm!important;background:#fff!important}.costRow>button,.costEmpty,.costPrintOnly{display:none!important}
 .costBottom{display:grid!important;grid-template-columns:1.1fr .95fr .8fr!important;gap:.8mm!important;margin-top:.4mm!important;break-inside:avoid!important}.costBottom>section{padding:.7mm!important;border-radius:.8mm!important;box-shadow:none!important}.costBottom h3{margin:0 0 .2mm!important;padding:.2mm!important;font-size:4.8pt!important}.costBottom textarea{height:9mm!important;min-height:9mm!important;padding:.3mm!important;font-size:4pt!important}.costBottom section>div{padding:.15mm .4mm!important;font-size:4pt!important;line-height:1.05!important}.costBottom section>div b{font-size:4.5pt!important}.costBottom .grand,.profitLine,.marginLine{font-size:4.7pt!important}
 /* 行数が増えた場合だけ明細行をさらに詰める */
 .costPage.printCompact .costRow{height:3.95mm!important;min-height:3.95mm!important}.costPage.printCompact .costRow>*{height:3.95mm!important;min-height:3.95mm!important}.costPage.printCompact .costRow input,.costPage.printCompact .taxIncludedCell>input{height:3.45mm!important;min-height:3.45mm!important}
 .costPage.printDense .costRow{height:3.55mm!important;min-height:3.55mm!important}.costPage.printDense .costRow>*{height:3.55mm!important;min-height:3.55mm!important}.costPage.printDense .costRow input,.costPage.printDense .taxIncludedCell>input{height:3.05mm!important;min-height:3.05mm!important;font-size:4.1pt!important}
}
