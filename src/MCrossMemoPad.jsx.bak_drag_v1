import {useEffect,useMemo,useState} from "react"; import "./MCrossMemoPad.css"; export default function MCrossMemoPad({open,onClose,company="",propertyName="",unit="",workName=""}){const storageKey=useMemo(()=>["mcross-property-memo-v1",company,propertyName,unit,workName].map(v=>encodeURIComponent(String(v||""))).join(":"),[company,propertyName,unit,workName]);const[data,setData]=useState({request:"",purchase:"",free:""});const[tab,setTab]=useState("request");useEffect(()=>{if(!open)return;try{const saved=JSON.parse(localStorage.getItem(storageKey)||"null");setData(saved&&typeof saved==="object"?{request:String(saved.request||""),purchase:String(saved.purchase||""),free:String(saved.free||"")}:{request:"",purchase:"",free:""})}catch{setData({request:"",purchase:"",free:""})}},[open,storageKey]);useEffect(()=>{if(!open)return;try{localStorage.setItem(storageKey,JSON.stringify({...data,updatedAt:new Date().toISOString()}))}catch{}},[data,open,storageKey]);if(!open)return null;const labels={request:"依頼内容",purchase:"購入予定",free:"自由メモ"};const placeholders={request:"依頼内容や確認事項を入力...",purchase:"購入予定の商品名やURLを入力...",free:"見積作成中に残したいことを入力..."};return <div className="mcrossMemoOverlay" role="dialog" aria-modal="true" aria-label="この物件のメモ帳" onPointerDown={e=>{if(e.target===e.currentTarget)onClose?.()}}><section className="mcrossMemoPad"><img className="mcrossMemoArtwork" src="/Designer (3).png" alt="" /><button type="button" className="mcrossMemoClose" onClick={onClose} aria-label="メモ帳を閉じる">×</button><div className="mcrossMemoTabs"><button type="button" className={tab==="request"?"active":""} onClick={()=>setTab("request")}>📋 依頼内容</button><button type="button" className={tab==="purchase"?"active":""} onClick={()=>setTab("purchase")}>🛒 購入予定</button><button type="button" className={tab==="free"?"active":""} onClick={()=>setTab("free")}>✏️ 自由メモ</button></div><div className="mcrossMemoEditor"><strong>{labels[tab]}</strong><textarea value={data[tab]} onChange={e=>setData(previous=>({...previous,[tab]:e.target.value}))} placeholder={placeholders[tab]} autoFocus /></div><div className="mcrossMemoFooter"><span>✓ 物件ごとに自動保存</span><button type="button" onClick={()=>{if(window.confirm(labels[tab]+"を消去しますか？"))setData(previous=>({...previous,[tab]:""}))}}>🗑 メモをクリア</button></div></section></div>}