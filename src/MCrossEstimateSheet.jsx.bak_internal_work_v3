import {useEffect,useMemo,useRef,useState} from 'react'
import './MCrossEstimateSheet.css'
/* M-CROSS_ESTIMATE_M_DECIMAL1_ONLY_V1_SAFE */
/* M-CROSS_ESTIMATE_DISPLAY_DECIMAL1_V2_SAFE */
/* M-CROSS_SELECTED_WORK_SERVICE_ORDER_V1_SAFE */
/* M-CROSS_ESTIMATE_DECIMAL1_BY_WORKTYPE_V3_SAFE */
/* M-CROSS_ESTIMATE_UNIT_QUANTITY_FACTOR_V1_SAFE */
import WorkInstructionModal from './WorkInstructionModal.jsx'
/* M-CROSS_WORK_INSTRUCTION_V4_SAFE */
import {estimateSheetConfig as config} from './estimateSheetConfig.js'
const yen=v=>'¥'+Math.round(Number(v)||0).toLocaleString('ja-JP')
const newRow=()=>({id:'estimate-'+Date.now()+'-'+Math.random().toString(36).slice(2,7),name:'',spec:'',quantity:1,unit:'式',rate:''})
/* M-CROSS_WORK_DRAG_SELECT_V3_SAFE */
let mcrossWorkSlide={active:false,selecting:true,touched:new Set()}
export default function MCrossEstimateSheet({company='',propertyName='',unit='',address='',workName='',rows:sourceRows=[],propertyAccess={},onGoMeasurement,onGoOrder,onGoCost,onExportEstimate,onOpenEstimateExcel,onCreateServiceOrder,onRefreshMeasurement,onRowsChange,onSourceRowsChange,versionToken}){
 const storageKey=['mcross_editable_estimate_v1',company,propertyName,unit,workName].map(v=>encodeURIComponent(String(v||''))).join(':')
 const[rows,setRows]=useState(()=>{try{const saved=JSON.parse(localStorage.getItem(storageKey)||'null');return Array.isArray(saved?.rows)?saved.rows.map(row=>{const text=String(row.name||row.label||'');const linear=String(row.unit||'').trim()==='m'||/クロス|CF貼/.test(text);return {...row,quantity:row.quantity===''?'':(linear?Math.round((Number(row.quantity)||0)*10)/10:Math.round((Number(row.quantity)||0)*100)/100),rate:row.rate===''?'':Math.round(Number(row.rate)||0)}}):[]}catch{return []}})
 /* M-CROSS_WORK_COPY_V2_SAFE */
 /* M-CROSS_WORK_CHECKBOX_LEFT_V1_SAFE */
 const[selectedWorkIds,setSelectedWorkIds]=useState([])
 /* M-CROSS_SELECTED_WORK_TO_COST_V1_SAFE */
 useEffect(()=>{try{const key=['mcross_cost_selected_work_v1',company,propertyName,unit,workName].map(v=>encodeURIComponent(String(v||''))).join(':');const picked=rows.filter(r=>selectedWorkIds.includes(r.id)).map(r=>({name:String(r.name||'').trim()})).filter(r=>r.name);localStorage.setItem(key,JSON.stringify(picked))}catch{}},[company,propertyName,unit,workName,rows,selectedWorkIds])
 const refreshRequestedRef=useRef(false)
 const lastVersionTokenRef=useRef(versionToken)
 const[showWorkInstruction,setShowWorkInstruction]=useState(false)
 const toggleWork=id=>setSelectedWorkIds(prev=>prev.includes(id)?prev.filter(v=>v!==id):[...prev,id])
 const setWorkSelected=(id,selected)=>setSelectedWorkIds(prev=>selected?(prev.includes(id)?prev:[...prev,id]):prev.filter(v=>v!==id))
 const beginWorkSlide=(event,id)=>{if(event.pointerType==='mouse'&&event.button!==0)return;event.preventDefault();const selecting=!selectedWorkIds.includes(id);mcrossWorkSlide={active:true,selecting,touched:new Set([id])};setWorkSelected(id,selecting)}
 const moveWorkSlide=event=>{if(!mcrossWorkSlide.active)return;event.preventDefault();const hit=document.elementFromPoint(event.clientX,event.clientY)?.closest?.('[data-work-check-id]');const id=hit?.dataset?.workCheckId;if(!id||mcrossWorkSlide.touched.has(id))return;mcrossWorkSlide.touched.add(id);setWorkSelected(id,mcrossWorkSlide.selecting)}
 const endWorkSlide=()=>{mcrossWorkSlide.active=false}
 const selectAllWork=()=>setSelectedWorkIds(rows.map(row=>row.id))
 const clearWork=()=>setSelectedWorkIds([])
 const workText=row=>String(row.name||'').replace(/[　 ]+/g,' ').trim()
 /* M-CROSS_WORK_COPY_DETAILS_V2_SAFE */
 const copySelectedWork=async()=>{const picked=rows.filter(row=>selectedWorkIds.includes(row.id));if(!picked.length){window.alert('コピーする作業項目を選択してください。');return}const property=[propertyName,unit?String(unit).replace(/号室$/,'')+'号室':''].filter(Boolean).join(' ');const workLines=picked.map(row=>{const name=workText(row);const q=Number(row.quantity);const u=String(row.unit||'').trim();const qty=(Number.isFinite(q)&&q>0&&u&&!(q===1&&u==='式'))?' '+String(Number.isInteger(q)?q:Math.round(q*10)/10)+u:'';return name?'・'+name+qty:''}).filter(Boolean);/* M-CROSS_WORK_COPY_ACCESS_V1_SAFE */const blocks=[];if(property)blocks.push('【物件】\n'+property);if(address)blocks.push('【住所】\n'+address);const accessLines=[['オートロック',propertyAccess.autoLock],['キーボックス',propertyAccess.keyBox],['ドアジョイナー',propertyAccess.joiner],['マイロック',propertyAccess.myLock],['玄関開放',propertyAccess.entranceOpen]].filter(([,value])=>String(value||'').trim()).map(([label,value])=>label+'：'+String(value).trim());if(accessLines.length)blocks.push('【鍵・入館情報】\n'+accessLines.join('\n'));blocks.push('【作業内容】\n'+workLines.join('\n'));const text=blocks.join('\n\n');try{await navigator.clipboard.writeText(text)}catch{const a=document.createElement('textarea');a.value=text;document.body.appendChild(a);a.select();document.execCommand('copy');a.remove()}window.alert(picked.length+'件の作業内容をコピーしました。')}
 useEffect(()=>{try{localStorage.setItem(storageKey,JSON.stringify({company,propertyName,unit,address,workName,rows,updatedAt:new Date().toISOString()}))}catch{}},[storageKey,company,propertyName,unit,address,workName,rows])
 useEffect(()=>{if(typeof onRowsChange==='function')onRowsChange(rows)},[rows,onRowsChange])
 useEffect(()=>{if(typeof onSourceRowsChange==='function')onSourceRowsChange(sourceRows)},[sourceRows,onSourceRowsChange])
 /* M-CROSS_LIVE_ROWS_SYNC_V1_SAFE */
 useEffect(()=>{if(typeof onRowsChange==='function')onRowsChange(rows)},[rows,onRowsChange])
 useEffect(()=>{if(typeof onSourceRowsChange==='function')onSourceRowsChange(sourceRows)},[sourceRows,onSourceRowsChange])
 const total=useMemo(()=>rows.reduce((sum,row)=>sum+(Number(row.quantity)||0)*(Number(row.rate)||0),0),[rows])
 const edit=(id,key,value)=>setRows(previous=>previous.map(row=>row.id===id?{...row,[key]:value}:row))
 const remove=id=>setRows(previous=>previous.filter(row=>row.id!==id))
 useEffect(()=>{const incoming=(Array.isArray(sourceRows)?sourceRows:[]).map((row,index)=>({id:'source-'+String(row.exclusionKey||row.id||index),sourceKey:String(row.exclusionKey||row.id||index),name:String((Array.isArray(row.parts)&&row.parts.filter(Boolean).length?row.parts.filter(Boolean).join(' '):row.label||'')).replace(/クロス部分張替/g,'クロス張替').replace(/[　 ]+/g,' ').trim(),spec:String(row.productCode||''),quantity:(String(row.unit||'').trim()==='m'?Math.round((Number(row.quantity)||0)*10)/10:Math.round((Number(row.quantity)||0)*100)/100),unit:String(row.unit||''),rate:row.rate===''||row.rate==null?'':Math.round(Number(row.rate)||0)}));setRows(previous=>{if(lastVersionTokenRef.current!==versionToken){lastVersionTokenRef.current=versionToken;return incoming}if(refreshRequestedRef.current){refreshRequestedRef.current=false;return incoming}return previous.length?previous:incoming})},[sourceRows,versionToken]); /* M-CROSS_ESTIMATE_AUTO_ADD_NEW_V1_SAFE */
 const importMeasurement=()=>{const incoming=(Array.isArray(sourceRows)?sourceRows:[]).map((row,index)=>({id:'source-'+String(row.exclusionKey||row.id||index),sourceKey:String(row.exclusionKey||row.id||index),name:String((Array.isArray(row.parts)&&row.parts.filter(Boolean).length?row.parts.filter(Boolean).join(' '):row.label||'')).replace(/クロス部分張替/g,'クロス張替').replace(/[　 ]+/g,' ').trim(),spec:String(row.productCode||''),quantity:(String(row.unit||'').trim()==='m'?Math.round((Number(row.quantity)||0)*10)/10:Math.round((Number(row.quantity)||0)*100)/100),unit:String(row.unit||''),rate:row.rate===''||row.rate==null?'':Math.round(Number(row.rate)||0)}));setRows(previous=>{const keys=new Set(previous.map(row=>row.sourceKey).filter(Boolean));return [...previous,...incoming.filter(row=>!keys.has(row.sourceKey))]})};const refreshMeasurement=()=>{const incoming=(Array.isArray(sourceRows)?sourceRows:[]).map((row,index)=>({id:'source-'+String(row.exclusionKey||row.id||index),sourceKey:String(row.exclusionKey||row.id||index),name:String((Array.isArray(row.parts)&&row.parts.filter(Boolean).length?row.parts.filter(Boolean).join(' '):row.label||'')).replace(/クロス部分張替/g,'クロス張替').replace(/[　 ]+/g,' ').trim(),spec:String(row.productCode||''),quantity:(String(row.unit||'').trim()==='m'?Math.round((Number(row.quantity)||0)*10)/10:Math.round((Number(row.quantity)||0)*100)/100),unit:String(row.unit||''),rate:row.rate===''||row.rate==null?'':Math.round(Number(row.rate)||0)}));const refreshed=typeof onRefreshMeasurement==='function'?onRefreshMeasurement():sourceRows;const latest=Array.isArray(refreshed)?refreshed:sourceRows;const rebuilt=latest.map((row,index)=>({id:'source-'+String(row.exclusionKey||row.id||index),sourceKey:String(row.exclusionKey||row.id||index),name:String((Array.isArray(row.parts)&&row.parts.filter(Boolean).length?row.parts.filter(Boolean).join(' '):row.label||'')).replace(/クロス部分張替/g,'クロス張替').replace(/[　 ]+/g,' ').trim(),spec:String(row.productCode||''),quantity:(String(row.unit||'').trim()==='m'?Math.round((Number(row.quantity)||0)*10)/10:Math.round((Number(row.quantity)||0)*100)/100),unit:String(row.unit||''),rate:row.rate===''||row.rate==null?'':Math.round(Number(row.rate)||0)}));refreshRequestedRef.current=false;setRows(rebuilt);setSelectedWorkIds([])}
 return <section className='mcrossEstimateWorkspace'>
  <nav className='mcrossEstimateNavigation'><button type='button' onClick={onGoMeasurement}>📐 工事内容・採寸</button><button type='button' onClick={onGoOrder}>📦 施工・材料発注</button><button type='button' onClick={onGoCost}>💰 原価計算</button><button type='button' onClick={()=>onExportEstimate(rows)}>💾 Excel書式で保存</button><button type='button' onClick={onOpenEstimateExcel}>📂 Excel書式を開く</button></nav>
  <section className='mcrossEstimatePaper' style={{'--paper':config.paperColor,'--accent':config.headerColor,'--grid':config.gridColor}}>
   <header className='mcrossEstimateHead'><div className='mcrossEstimateBrand'><strong>M-Cross</strong><small>MavieSelect</small></div><h2>御 見 積 書</h2>{config.showMascot && <img src='/Designer.png' alt='' />}</header>
   <section className='mcrossEstimateMeta'><div><strong>{company||'管理会社'} 御中</strong><dl><div><dt>物件名</dt><dd>{propertyName}</dd></div><div><dt>号室</dt><dd>{unit?unit+'号室':''}</dd></div><div><dt>住所</dt><dd>{address}</dd></div><div><dt>工事名</dt><dd>{workName}</dd></div></dl></div><aside><b>株式会社 MavieSelect</b><span>〒060-0007</span><span>札幌市中央区北7条西22丁目1-12-201</span><span>TEL 011-699-6492　FAX 011-699-6493</span></aside></section>
   <div className='mcrossEstimateToolbar'><button type='button' onClick={importMeasurement}>📐 採寸・工事内容から取り込む</button><button type='button' onClick={()=>{if(window.confirm('現在の見積明細を破棄して、最新の採寸・工事内容から作り直します。見積画面で直接変更した内容も置き換わります。続けますか？'))refreshMeasurement()}}>🔄 採寸・工事内容から再作成</button><button type='button' onClick={()=>setRows(previous=>[...previous,newRow()])}>＋ 空の行を追加</button><button type='button' onClick={selectAllWork}>☑ 作業をすべて選択</button><button type='button' onClick={clearWork}>選択解除</button><button type='button' className='mcrossWorkCopyButton' onClick={copySelectedWork}>📋 選択した作業をコピー（{selectedWorkIds.length}件）</button><button type='button' className='mcrossWorkInstructionButton' onClick={()=>selectedWorkIds.length?setShowWorkInstruction(true):window.alert('作業指示書に載せる項目を選択してください。')}>📄 作業指示書（{selectedWorkIds.length}件）</button><button type='button' className='mcrossWorkOrderButton' onClick={()=>{const picked=rows.filter(row=>selectedWorkIds.includes(row.id));if(!picked.length){window.alert('施工発注する作業を選択してください。');return}if(typeof onCreateServiceOrder==='function')onCreateServiceOrder(picked)}}>👷 選択した作業を施工発注（{selectedWorkIds.length}件）</button></div>
   <div className='mcrossEstimateTable editable'><div className='mcrossEstimateRow head'><span>No.</span><span className='mcrossWorkCheckHead'>選択</span><span>工事項目</span><span>仕様・品番</span><span>数量</span><span>単位</span><span>単価</span><span>金額</span><span>操作</span></div>{rows.map((row,index)=><div className='mcrossEstimateRow' key={row.id}><span>{index+1}</span><span className={'mcrossWorkCheckCell '+(selectedWorkIds.includes(row.id)?'selected':'')} data-work-check-id={row.id} onPointerDown={event=>beginWorkSlide(event,row.id)} onPointerMove={moveWorkSlide} onPointerUp={endWorkSlide} onPointerCancel={endWorkSlide}><input type='checkbox' checked={selectedWorkIds.includes(row.id)} onChange={()=>{}} aria-label={(workText(row)||'作業')+'を作業用に選択'} /></span><span><input value={row.name} onChange={e=>edit(row.id,'name',e.target.value)} placeholder='例：居間 クロス張替'/></span><span><input value={row.spec} onChange={e=>edit(row.id,'spec',e.target.value)} placeholder='品番・仕様'/></span><span><input type='number' min='0' step='0.1' value={(String(row.unit||'').trim()==='m'||/クロス|CF貼/.test(String(row.name||'')))?Math.round((Number(row.quantity)||0)*10)/10:row.quantity} onChange={e=>edit(row.id,'quantity',e.target.value)}/></span><span><input value={row.unit} onChange={e=>edit(row.id,'unit',e.target.value)}/></span><span><input type='number' min='0' step='1' value={row.rate} onChange={e=>edit(row.id,'rate',e.target.value)} placeholder='0'/></span><span>{yen((Number(row.quantity)||0)*(Number(row.rate)||0))}</span><span className='mcrossEstimateActions'><button type='button' className='mcrossEstimateDelete' onClick={()=>remove(row.id)} aria-label={(workText(row)||'見積項目')+'を削除'}>×</button></span></div>)}</div>
   <footer><div className='mcrossEstimateNotes'><b>備考</b><textarea placeholder='必要な場合に入力'/></div><div className='mcrossEstimateTotal'><div><span>小計</span><strong>{yen(total)}</strong></div><div><span>消費税（10%）</span><strong>{yen(Math.floor(total*0.1))}</strong></div><div className='grand'><span>合計</span><strong>{yen(total+Math.floor(total*0.1))}</strong></div></div></footer>
  </section>
 <WorkInstructionModal open={showWorkInstruction} onClose={()=>setShowWorkInstruction(false)} propertyName={propertyName} unit={unit} address={address} workName={workName} propertyAccess={propertyAccess} rows={rows} selectedIds={selectedWorkIds} />
 </section>
}
