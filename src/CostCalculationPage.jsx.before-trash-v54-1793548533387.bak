import React,{useEffect,useMemo,useState}from'react'
import'./CostCalculationPage.css'
const yen=n=>'¥'+Math.round(Number(n)||0).toLocaleString('ja-JP')
const num=v=>Number.isFinite(Number(v))?Number(v):0
const defs=[
 {key:'internal',title:'自社作業',note:'自社スタッフの作業',tone:'blue',rows:6,heads:['作業内容','作業者'],icon:'person'},
 {key:'service',title:'施工業者・職人',note:'外注工事の発注',tone:'pink',rows:6,heads:['工種','業者名'],icon:'tool'},
 {key:'material',title:'材料発注',note:'問屋・登録業者からの購入',tone:'mint',rows:8,heads:['商品名','発注先'],icon:'box'},
 {key:'retail',title:'店頭・ネット購入',note:'ホームセンター・Amazon等',tone:'purple',rows:6,heads:['商品名','購入先'],icon:'bag'},
 {key:'expense',title:'現場経費',note:'ゴミ処理・駐車場・その他',tone:'gray',rows:3,heads:['項目','内容'],icon:'parking'}]
const blank=()=>({id:'c'+Date.now()+Math.random().toString(36).slice(2),name:'',party:'',quantity:1,unit:'式',rate:'',taxIncluded:''})
const initRows=()=>Object.fromEntries(defs.map(d=>[d.key,Array.from({length:d.rows},blank)]))
const fillRows=src=>Object.fromEntries(defs.map(d=>{const a=Array.isArray(src?.[d.key])?src[d.key]:[];return[d.key,a.length>=d.rows?a:[...a,...Array.from({length:d.rows-a.length},blank)]]}))
function Icon({type}){const p={viewBox:'0 0 48 48','aria-hidden':true};if(type==='doc')return <svg {...p}><rect x="9" y="5" width="30" height="38" rx="5"/><path d="M16 17h16M16 25h16M16 33h10" stroke="#fff" strokeWidth="4" fill="none" strokeLinecap="round"/></svg>;if(type==='coin')return <svg {...p}><ellipse cx="24" cy="15" rx="14" ry="7"/><path d="M10 15v9c0 4 6 7 14 7s14-3 14-7v-9M10 24v9c0 4 6 7 14 7s14-3 14-7v-9"/></svg>;if(type==='chart')return <svg {...p}><rect x="7" y="29" width="8" height="13" rx="2"/><rect x="20" y="20" width="8" height="22" rx="2"/><rect x="33" y="10" width="8" height="32" rx="2"/><path d="M9 21l12-8 10 2 10-9" fill="none" stroke="currentColor" strokeWidth="4"/></svg>;if(type==='pie')return <svg {...p}><path d="M22 5a19 19 0 1 0 19 19H22z"/><path d="M27 5v14h14A19 19 0 0 0 27 5z" opacity=".55"/></svg>;if(type==='person')return <svg {...p}><circle cx="24" cy="14" r="8"/><path d="M10 42c1-12 6-18 14-18s13 6 14 18z"/></svg>;if(type==='tool')return <svg {...p}><path d="M30 6a10 10 0 0 0-9 14L7 34a5 5 0 0 0 7 7l14-14a10 10 0 0 0 14-9l-8 5-7-7z"/></svg>;if(type==='box')return <svg {...p}><path d="M6 15 24 6l18 9-18 9zM6 15v21l18 9V24zm36 0v21l-18 9V24z"/></svg>;if(type==='bag')return <svg {...p}><path d="M9 16h30l-3 27H12z"/><path d="M17 18c0-10 14-10 14 0" fill="none" stroke="currentColor" strokeWidth="4"/></svg>;return <svg {...p}><rect x="7" y="7" width="34" height="34" rx="8"/><path d="M18 37V11h9a8 8 0 0 1 0 16h-9m0-8h9" fill="none" stroke="#fff" strokeWidth="4"/></svg>}
export default function CostCalculationPage({onBack}){
 const[info,setInfo]=useState({propertyName:'',unit:'',staff:'町田',period:'',estimate:0})
 const[rows,setRows]=useState(initRows)
 useEffect(()=>{try{const v=JSON.parse(localStorage.getItem('mcross_cost_calculation_v1')||'null');if(v?.info)setInfo(x=>({...x,...v.info}));if(v?.rows)setRows(fillRows(v.rows))}catch{}},[])
 useEffect(()=>{try{localStorage.setItem('mcross_cost_calculation_v1',JSON.stringify({info,rows}))}catch{}},[info,rows])
 const amount=(key,r)=>key==='retail'&&r.taxIncluded!==''?Math.floor(num(r.taxIncluded)/1.1):num(r.quantity)*num(r.rate)
 const sums=useMemo(()=>Object.fromEntries(defs.map(d=>[d.key,(rows[d.key]||[]).reduce((s,r)=>s+amount(d.key,r),0)])),[rows])
 const total=Object.values(sums).reduce((a,b)=>a+b,0),profit=num(info.estimate)-total,margin=num(info.estimate)?profit/num(info.estimate)*100:0
 const edit=(key,id,f,v)=>setRows(p=>({...p,[key]:p[key].map(r=>r.id===id?{...r,[f]:v}:r)}))
 const add=key=>setRows(p=>({...p,[key]:[...p[key],blank()]})),del=(key,id)=>setRows(p=>({...p,[key]:p[key].filter(r=>r.id!==id)}))
 const importOrders=()=>{try{const all=JSON.parse(localStorage.getItem('mcross_purchase_orders_v1')||'[]');const next={service:[],material:[]};(Array.isArray(all)?all:[]).filter(o=>(!info.propertyName||o.propertyName===info.propertyName)&&(!info.unit||String(o.unit)===String(info.unit))).forEach(o=>(o.items||[]).forEach(x=>next[o.orderMode==='material'?'material':'service'].push({...blank(),name:x.label||x.productCode||'',party:o.contractorName||'',quantity:x.orderQuantity??x.quantity??1,unit:x.unit||'式',rate:x.orderRate??x.rate??''})));setRows(p=>({...p,service:next.service.length?fillRows({service:next.service}).service:p.service,material:next.material.length?fillRows({material:next.material}).material:p.material}))}catch{alert('発注書を読み込めませんでした。')}}
 return <main className="cc-page">
  <header className="cc-title"><h1>原価計算書</h1><div><button onClick={onBack}>← 戻る</button><button className="print" onClick={()=>window.print()}>▣ 印刷 / PDF出力</button></div></header>
  <section className="cc-info"><label><b>物件</b><span><input value={info.propertyName} onChange={e=>setInfo({...info,propertyName:e.target.value})} placeholder="物件名"/><input className="unit" value={info.unit} onChange={e=>setInfo({...info,unit:e.target.value})} placeholder="号室"/></span></label><label><b>担当者</b><input value={info.staff} onChange={e=>setInfo({...info,staff:e.target.value})}/></label><label><b>完了日</b><input type="date" value={info.period||''} onChange={e=>setInfo({...info,period:e.target.value})}/></label></section>
  <section className="cc-kpis"><article className="estimate"><Icon type="doc"/><div><b>見積金額(税抜)</b><label>¥<input type="number" value={info.estimate===''?0:info.estimate} onFocus={e=>e.currentTarget.select()} onChange={e=>setInfo({...info,estimate:e.target.value})}/></label><small>税込 {yen(num(info.estimate)*1.1)}</small></div></article><article className="cost"><Icon type="coin"/><div><b>原価合計(税抜)</b><strong>{yen(total)}</strong></div></article><article className="profit"><Icon type="chart"/><div><b>粗利益(税抜)</b><strong>{yen(profit)}</strong></div></article><article className="margin"><Icon type="pie"/><div><b>粗利率</b><strong>{margin.toFixed(1)}%</strong></div></article></section>
  {defs.map(d=><section className={'cc-section '+d.tone} key={d.key}><header><div className="cc-section-title"><span><Icon type={d.icon}/></span><b>{d.title}</b><small>（{d.note}）</small></div><div className="cc-section-actions"><em>小計</em><strong>{yen(sums[d.key])}</strong><button onClick={()=>add(d.key)}>＋ 行を追加</button>{(d.key==='service'||d.key==='material')&&<button onClick={importOrders}>＋ 発注書から取り込む</button>}</div></header><div className="cc-grid"><div className="cc-head"><span>{d.heads[0]}</span><span>{d.heads[1]}</span><span>数量</span><span>単位</span><span>単価</span><span>金額</span><span>税込金額</span><span>操作</span></div>{rows[d.key].map(r=>{const a=amount(d.key,r);return <div className="cc-row" key={r.id}><div><input value={r.name} onChange={e=>edit(d.key,r.id,'name',e.target.value)}/></div><div><input value={r.party} onChange={e=>edit(d.key,r.id,'party',e.target.value)}/></div><div><input type="number" value={r.quantity} onChange={e=>edit(d.key,r.id,'quantity',e.target.value)}/></div><div><input value={r.unit} onChange={e=>edit(d.key,r.id,'unit',e.target.value)}/></div><div><input type="number" value={r.rate} onChange={e=>edit(d.key,r.id,'rate',e.target.value)}/></div><div className="money">{yen(a)}</div><div className="tax">{d.key==='retail'?<input type="number" value={r.taxIncluded} placeholder="税込金額" onChange={e=>edit(d.key,r.id,'taxIncluded',e.target.value)}/>:yen(a*1.1)}</div><div className="op"><button onClick={()=>del(d.key,r.id)}>▣</button></div></div>})}</div></section>)}
 </main>
}
