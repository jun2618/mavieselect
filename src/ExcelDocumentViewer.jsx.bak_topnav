import {useState} from "react";
import ExcelJS from "exceljs";
import "./ExcelDocumentViewer.css";
export default function ExcelDocumentViewer(){const[v,setV]=useState(null),[i,setI]=useState(0);async function open(f){if(!f)return;try{const w=new ExcelJS.Workbook();await w.xlsx.load(await f.arrayBuffer());const s=w.worksheets.map(x=>({name:x.name,rows:Array.from({length:Math.min(x.rowCount,120)},(_,r)=>Array.from({length:Math.min(x.columnCount,20)},(_,c)=>{const v=x.getRow(r+1).getCell(c+1).value;if(v==null)return "";if(typeof v==="object"&&v.text!=null)return String(v.text);if(typeof v==="object"&&v.result!=null)return String(v.result);return String(v)}))}));setI(0);setV({name:f.name,sheets:s})}catch(e){alert("Excelを読み込めませんでした`n"+e.message)}}const s=v?.sheets?.[i];return <><label className="excelOpenButton" style={{display:"none"}}>📂 Excel書類を開く<input type="file" accept=".xlsx,.xlsm" onChange={e=>{open(e.target.files?.[0]);e.target.value=""}}/></label>{v&&<div className="excelViewerBackdrop"><section className="excelViewer"><header><strong>{v.name}</strong><button type="button" onClick={()=>setV(null)}>×</button></header><select value={i} onChange={e=>setI(Number(e.target.value))}>{v.sheets.map((x,n)=><option key={x.name} value={n}>{x.name}</option>)}</select><div className="excelViewerTable"><table><tbody>{(s?.rows||[]).map((r,n)=><tr key={n}>{r.map((x,j)=><td key={j}>{x}</td>)}</tr>)}</tbody></table></div></section></div>}</>}
